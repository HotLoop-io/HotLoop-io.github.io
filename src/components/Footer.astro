---
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap-wide top">
    <div class="about">
      <a class="brand" href="/" aria-label="HotLoop, home">
        <img src="/brand/logo-mark.svg" alt="" width="28" height="28" />
        <span class="word">hot<span>loop</span></span>
      </a>
      <p>Automation loops for the real world. Two products, licensed separately, on purpose.</p>
    </div>

    <nav aria-label="Products">
      <h2>Products</h2>
      <a href="/gateway/">HotLoop Gateway</a>
      <a href="/flow/">HotLoop Flow</a>
      <a href="/integrations/">Integrations</a>
      <a href="/releases/">Release notes</a>
    </nav>

    <nav aria-label="Resources">
      <h2>Resources</h2>
      <a href="https://docs.hotloop.io">Documentation</a>
      <a href="/license/">Licensing</a>
      <a href="/releases/rss.xml">Release feed (RSS)</a>
    </nav>

    <nav aria-label="Community">
      <h2>Community</h2>
      <a href="https://github.com/HotLoop-io">GitHub</a>
      <a href="https://github.com/orgs/HotLoop-io/discussions">Discussions</a>
      <a href="https://www.reddit.com/r/HotLoop/">Reddit, r/HotLoop</a>
      <a href="mailto:support@hotloop.io">support@hotloop.io</a>
    </nav>
  </div>

  <div class="wrap-wide bottom">
    <p>
      HotLoop Gateway is free for individual use, with business use through <a href="https://embernet.ai">Embernet</a>.
      HotLoop Flow is Apache-2.0, free for everyone.
    </p>
    <p class="small">&copy; {year} HotLoop</p>
  </div>
</footer>

<style>
  footer.site { border-top: 1px solid var(--hl-border); background: var(--hl-sunken); margin-top: var(--hl-s9); }
  .top { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: var(--hl-s7); padding-block: var(--hl-s8) var(--hl-s7); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--hl-ink); margin-bottom: var(--hl-s3); }
  .word { font-weight: 800; font-size: 1.15rem; letter-spacing: -0.03em; }
  .word span { color: var(--hl-link); }
  :global(:root[data-theme='dark']) .word span { color: var(--hl-orange); }
  .about p { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); max-width: 34ch; }
  nav { display: grid; gap: var(--hl-s2); align-content: start; }
  nav h2 {
    font-size: var(--hl-fs-2xs); font-weight: 600; letter-spacing: var(--hl-ls-label);
    text-transform: uppercase; color: var(--hl-ink-soft); margin-bottom: var(--hl-s2);
  }
  nav a { color: var(--hl-ink); text-decoration: none; font-size: var(--hl-fs-sm); }
  nav a:hover { color: var(--hl-link); text-decoration: underline; }
  .bottom {
    display: flex; flex-wrap: wrap; gap: var(--hl-s3) var(--hl-s6); justify-content: space-between;
    padding-block: var(--hl-s5); border-top: 1px solid var(--hl-border);
    color: var(--hl-ink-soft); font-size: var(--hl-fs-xs);
  }
  .bottom p { max-width: 70ch; }
  @media (max-width: 800px) { .top { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
