---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { forPage } from '../i18n/page';
const { t, rich, to } = forPage(Astro.url.pathname);
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap-wide top">
    <div class="about">
      <a class="brand" href={to('/')} aria-label={t('c.home')}>
        <img src="/brand/logo-mark.svg" alt="" width="28" height="28" />
        <span class="word">hot<span>loop</span></span>
      </a>
      <p>{t('f.tagline')} {t('f.family')}</p>
    </div>

    <nav aria-label={t('f.products')}>
      <h2>{t('f.products')}</h2>
      <a href={to('/products/')}>{t('f.lineup')}</a>
      <a href="/iot/">HotLoop IoT</a>
      <a href="/edge/">HotLoop Edge</a>
      <a href="/gateway/">HotLoop Gateway</a>
      <a href="/edge-relay/">HotLoop Edge Relay</a>
      <a href="/flow/">HotLoop Flow</a>
      <a href="/cascade/">HotLoop Cascade</a>
      <a href="/codesys/">HotLoop for CODESYS</a>
      <a href="/transmitter/">HotLoop Transmitter</a>
      <a href="/unifi/">{t('f.unifi')}</a>
      <a href="/integrations/">{t('f.integrations')}</a>
      <a href={to('/releases/')}>{t('f.releases')}</a>
    </nav>

    <nav aria-label={t('f.resources')}>
      <h2>{t('f.resources')}</h2>
      <a href="https://docs.hotloop.io">{t('f.docs')}</a>
      <a href="https://docs.hotloop.io/roadmap/">{t('f.roadmap')}</a>
      <a href="https://docs.hotloop.io/flow/roadmap/">{t('f.flowRoadmap')}</a>
      <a href="https://docs.hotloop.io/cascade/roadmap/">{t('f.cascadeRoadmap')}</a>
      <a href="https://docs.hotloop.io/codesys/roadmap/">{t('f.codesysRoadmap')}</a>
      <a href="https://docs.hotloop.io/transmitter/roadmap/">{t('f.transmitterRoadmap')}</a>
      <a href="/license/">{t('f.license')}</a>
      <a href="/terms/">{t('f.terms')}</a>
      <a href="/privacy/">{t('f.privacy')}</a>
      <a href="/about/">{t('f.about')}</a>
      <a href="/contact/">{t('f.contact')}</a>
      <a href={to('/releases/rss.xml')}>{t('f.rss')}</a>
    </nav>

    <nav aria-label={t('f.community')}>
      <h2>{t('f.community')}</h2>
      <a href="https://github.com/HotLoop-io">GitHub</a>
      <a href="https://github.com/orgs/HotLoop-io/discussions">{t('f.discussions')}</a>
      <a href="https://www.reddit.com/r/HotLoop/">{t('f.reddit')}</a>
      <a href="mailto:info@hotloop.ai">{t('f.support')}</a>
    </nav>
  </div>

  <div class="wrap-wide langrow"><LanguageSwitcher variant="footer" /></div>

  <div class="wrap-wide bottom">
    <p set:html={rich('f.licenseLine')} />
    <p class="small">&copy; {year} HotLoop LLC <span aria-hidden="true">&middot;</span> <button type="button" class="cookie-link" data-cookie-settings>{t('ck.settings')}</button></p>
  </div>
</footer>

<style>
  footer.site { border-top: 1px solid var(--hl-border); background: var(--hl-sunken); margin-top: var(--hl-s9); }
  .top { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: var(--hl-s7); padding-block: var(--hl-s8) var(--hl-s7); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--hl-ink); margin-bottom: var(--hl-s3); }
  .word { font-weight: 800; font-size: 1.15rem; letter-spacing: -0.03em; }
  .word span { color: var(--hl-link); }
  :global(:root[data-theme='dark']) .word span { color: var(--hl-orange); }
  .about p { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); max-width: 34ch; }
  nav { display: grid; gap: var(--hl-s2); align-content: start; }
  nav h2 {
    font-size: var(--hl-fs-2xs); font-weight: 600; letter-spacing: var(--hl-ls-label);
    text-transform: uppercase; color: var(--hl-ink-soft); margin-bottom: var(--hl-s2);
  }
  nav a { color: var(--hl-ink); text-decoration: none; font-size: var(--hl-fs-sm); }
  nav a:hover { color: var(--hl-link); text-decoration: underline; }
  .langrow { padding-bottom: var(--hl-s5); }
  .bottom {
    display: flex; flex-wrap: wrap; gap: var(--hl-s3) var(--hl-s6); justify-content: space-between;
    padding-block: var(--hl-s5); border-top: 1px solid var(--hl-border);
    color: var(--hl-ink-soft); font-size: var(--hl-fs-xs);
  }
  .bottom p { max-width: 70ch; }
  .cookie-link { background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; text-decoration: underline; }
  .cookie-link:hover { color: var(--hl-link); }
  @media (max-width: 800px) { .top { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
