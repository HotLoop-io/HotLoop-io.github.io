---
// The same strip on all eight product pages: the one family sentence, which release
// line this product ships on, and its docs, install, release notes and roadmap.
import { getCollection } from 'astro:content';
import { LINES, memberOf, lineOf } from '../lib/family';
import { forPage } from '../i18n/page';

const { t, to } = forPage(Astro.url.pathname);

const { id } = Astro.props as { id: string };
const m = memberOf(id);
const line = lineOf(id);
let version = line.version;
if (line.id === 'flow') {
  const rel = (await getCollection('releases')).filter((r) => r.data.product === 'flow' && r.data.published);
  version = rel.sort((a, b) => b.data.version.localeCompare(a.data.version, undefined, { numeric: true }))[0].data.version;
}
const shared = line.members.length > 1 ? t('fl.shared', { others: line.members.filter((x) => x.id !== id).map((x) => x.name.replace('HotLoop ', '')).join(', ') }) : '';
---

<aside class="family" aria-label={t('fl.aria')}>
  <p>{t('f.family')} <a href={to('/products/')}>{t('fl.seeAll')}</a>.</p>
  <p class="line"><span class="chip ok">{t('m.lineRel', { line: line.label, version })}</span> {shared}</p>
  <p class="links">
    <a href={m.docs}>{t('fl.docs')}</a>
    <a href={m.install}>{t('fl.install')}</a>
    <a href={to(m.releases)}>{t('fl.notes')}</a>
    <a href={m.roadmap}>{t('fl.roadmap')}</a>
  </p>
</aside>

<style>
  .family { border-top: 1px solid var(--hl-border); padding-top: var(--hl-s4); display: grid; gap: var(--hl-s2); max-width: 70ch; }
  .family p { margin: 0; font-size: var(--hl-fs-sm); color: var(--hl-ink-soft); }
  .family .links { display: flex; flex-wrap: wrap; gap: var(--hl-s2) var(--hl-s5); font-weight: 600; }
</style>
