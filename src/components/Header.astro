---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/gateway/', label: 'Gateway' },
  { href: '/flow/', label: 'Flow' },
  { href: '/integrations/', label: 'Integrations' },
  { href: '/releases/', label: 'Releases' },
  { href: '/license/', label: 'License' },
];
const active = (href: string) => path === href || path.startsWith(href);
---

<header class="site">
  <div class="wrap-wide bar">
    <a class="brand" href="/" aria-label="HotLoop, home">
      <img src="/brand/logo-mark.svg" alt="" width="30" height="30" />
      <span class="word">hot<span>loop</span></span>
    </a>

    <nav aria-label="Primary" class="desktop">
      {links.map((l) => (
        <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="https://docs.hotloop.io">Docs</a>
    </nav>

    <div class="actions">
      <a class="gh" href="https://github.com/HotLoop-io" aria-label="HotLoop on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
        <span>GitHub</span>
      </a>
      <ThemeToggle />
      <details class="menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav aria-label="Mobile" class="sheet">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="https://docs.hotloop.io">Docs</a>
          <a href="https://github.com/HotLoop-io">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  header.site {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--hl-bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--hl-border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--hl-s5); height: 68px; }

  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--hl-ink); }
  .word { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; }
  .word span { color: var(--hl-link); }
  :global(:root[data-theme='dark']) .word span { color: var(--hl-orange); }

  nav.desktop { display: flex; gap: var(--hl-s1); }
  nav.desktop a {
    color: var(--hl-ink-soft); text-decoration: none;
    font-size: var(--hl-fs-sm); font-weight: 600;
    padding: 0.5em 0.9em; border-radius: var(--hl-r-pill);
    transition: color var(--hl-transition-fast), background var(--hl-transition-fast);
  }
  nav.desktop a:hover { color: var(--hl-ink); background: var(--hl-sunken); }
  nav.desktop a[aria-current='page'] { color: var(--hl-ink); background: var(--hl-sunken); }

  .actions { display: flex; align-items: center; gap: var(--hl-s2); }
  .gh {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 0 16px; height: 40px; border-radius: var(--hl-r-pill);
    border: 1px solid var(--hl-border); background: var(--hl-card);
    color: var(--hl-ink); text-decoration: none; font-weight: 600; font-size: var(--hl-fs-sm);
  }
  .gh:hover { border-color: var(--hl-line-strong); color: var(--hl-ink); }
  .gh svg { width: 17px; height: 17px; }

  /* The mobile menu is a <details>, so it works with JavaScript off. */
  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--hl-border); background: var(--hl-card); cursor: pointer;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu svg { width: 20px; height: 20px; }
  .sheet {
    position: absolute; right: 0; top: 52px; min-width: 220px;
    display: grid; padding: var(--hl-s2);
    background: var(--hl-card); border: 1px solid var(--hl-border);
    border-radius: var(--hl-r-card); box-shadow: var(--hl-sh-2);
  }
  .sheet a { padding: 0.75em 1em; border-radius: var(--hl-r-sm); color: var(--hl-ink); text-decoration: none; font-weight: 600; }
  .sheet a:hover { background: var(--hl-sunken); }

  @media (max-width: 900px) {
    nav.desktop, .gh { display: none; }
    .menu { display: block; }
  }
</style>
