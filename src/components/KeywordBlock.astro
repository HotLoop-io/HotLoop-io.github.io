---
// English-only selling sections for the pages the keyword plan retargets: an H2, its paragraphs, and the
// call to action that closes it, then the FAQ entries for the page with the same words in FAQPage data.
// Like AlsoSee, it renders on the English page only, so a translated page never shows English copy.
import { forPage } from '../i18n/page';
import JsonLd from './JsonLd.astro';
interface Props {
  sections?: { h2: string; body: string[]; cta: { text: string; href: string } }[];
  faq?: { q: string; a: string }[];
}
const { sections = [], faq = [] } = Astro.props;
const { locale } = forPage(Astro.url.pathname);
---

{locale.tag === 'en' && sections.map((s) => (
  <section class="block kw">
    <div class="wrap">
      <h2>{s.h2}</h2>
      {s.body.map((p) => <p class="muted">{p}</p>)}
      <p class="kw-cta"><a class="btn primary" href={s.cta.href}>{s.cta.text}</a></p>
    </div>
  </section>
))}
{locale.tag === 'en' && faq.length > 0 && (
  <section class="block kw">
    <div class="wrap">
      <JsonLd data={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }} />
      <h2>Questions people ask</h2>
      {faq.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .kw h2 { font-size: var(--hl-fs-xl); }
  .kw p { max-width: 78ch; margin-top: var(--hl-s3); }
  .kw-cta { margin-top: var(--hl-s4); }
  .faq { border-bottom: 1px solid var(--hl-border); padding-block: var(--hl-s3); max-width: 78ch; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin-top: var(--hl-s2); }
</style>
