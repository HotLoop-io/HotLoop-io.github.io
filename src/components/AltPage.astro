---
// One layout for the "alternative to" and how-to pages. English only, like About and Contact, so
// the copy lives in the page and there is no translation catalog to keep in step. Every FAQ answer
// is plain text because the same words go into the FAQPage structured data and have to match.
import Base from '../layouts/Base.astro';
import JsonLd from './JsonLd.astro';
import { FAMILY_SENTENCE } from '../lib/family';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lede: string;
  path: string;
  faq: { q: string; a: string }[];
  cta: { label: string; href: string };
  more: { label: string; href: string }[];
}
const { title, description, eyebrow, h1, lede, path, faq, cta, more } = Astro.props;
---

<Base title={title} description={description} ogAlt={h1}>
  <JsonLd
    slot="head"
    data={[
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'HotLoop', item: 'https://hotloop.io/' },
          { '@type': 'ListItem', position: 2, name: eyebrow, item: `https://hotloop.io${path}` },
        ],
      },
    ]}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <span class="label">{eyebrow}</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <div class="cluster">
        <a class="btn primary" href={cta.href}>{cta.label}</a>
        <a class="btn" href="/products/">Compare all eight products</a>
      </div>
    </div>
  </section>
  <article class="wrap body stack">
    <slot />
    <h2>Questions people ask</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <h2>Keep reading</h2>
    <ul class="more">
      {more.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
    </ul>
    <p class="family">{FAMILY_SENTENCE} <a href="/products/">See every product</a>. Home and lab use is free, and so is use by schools, nonprofits, and government bodies. <a href="/license/">Read which license applies to you</a>.</p>
  </article>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s6); }
  .body { max-width: 860px; padding-bottom: var(--hl-s8); }
  .body :global(h2) { font-size: var(--hl-fs-xl); margin-top: var(--hl-s6); }
  .body :global(h3) { font-size: var(--hl-fs-lg); margin-top: var(--hl-s5); }
  .body :global(table) { width: 100%; border-collapse: collapse; font-size: var(--hl-fs-sm); }
  .body :global(th), .body :global(td) { text-align: left; vertical-align: top; padding: var(--hl-s2) var(--hl-s3); border-bottom: 1px solid var(--hl-border); }
  .body :global(th) { font-size: var(--hl-fs-2xs); letter-spacing: var(--hl-ls-label); text-transform: uppercase; }
  .body :global(pre) { overflow-x: auto; padding: var(--hl-s3); background: var(--hl-sunken); border-radius: 6px; font-size: var(--hl-fs-sm); }
  .faq { border-bottom: 1px solid var(--hl-border); padding-block: var(--hl-s3); }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin-top: var(--hl-s2); }
  .more { display: grid; gap: var(--hl-s2); padding-left: var(--hl-s4); }
  .family { margin-top: var(--hl-s6); color: var(--hl-ink-soft); }
</style>
