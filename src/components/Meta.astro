---
// Every page gets a canonical URL, Open Graph, and a large-image Twitter card.
// Before this existed, a link to hotloop.io pasted into Slack, Discord, X, or
// Reddit rendered as a bare grey URL.
//
// Titles are written per page and kept under 60 characters, because Google
// truncates around there. A title that does not already say HotLoop gets it
// appended. Descriptions are kept between 70 and 160 characters for the same
// reason, and scripts/seo-audit.mjs fails the build if either rule is broken.
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

import { LOCALES, split, href, TRANSLATED } from '../i18n/locales';
import { useT } from '../i18n/t';

const { title, description, ogImage, ogAlt, type = 'website', noindex = false } = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;

// og:image has to be absolute, or most crawlers will not fetch it.
// A translated page shares the English page's social card; the card is a picture of the brand, and the
// per-language title, description and alt text carry the language.
const { locale, rest } = split(Astro.url.pathname);
const slug = rest.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const image = new URL(ogImage ?? `/og/${slug}.png`, site).href;

const full = title.includes('HotLoop') ? title : `${title} · HotLoop`;

// hreflang: every language a page exists in, itself included, and x-default pointing at English.
// A page that is English only gets none, so no tag ever points at a page that is not there.
const alternates = TRANSLATED.includes(rest)
  ? LOCALES.map((l) => ({ tag: l.tag, url: new URL(href(rest, l), site).href }))
  : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.tag} href={a.url} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].url} />}
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={useT(locale).t('rel.rssTitle')} href={href('/releases/rss.xml', locale)} />
<meta name="theme-color" content="#FBFAF8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14120F" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="HotLoop" />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt ?? title} />
<meta property="og:locale" content={locale.og} />
{alternates.filter((a) => a.tag !== locale.tag).map((a) => <meta property="og:locale:alternate" content={LOCALES.find((l) => l.tag === a.tag)!.og} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={full} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={ogAlt ?? title} />
