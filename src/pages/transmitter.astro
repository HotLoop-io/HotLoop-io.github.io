---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import FamilyLine from '../components/FamilyLine.astro';
import { TRANSMITTER } from '../lib/products';

const R = TRANSMITTER.released;
const base = `${TRANSMITTER.downloads}${TRANSMITTER.version}/`;
const libFile = `HotLoopTransmitter-${TRANSMITTER.version}.library`;

const snippet = `PROGRAM PLC_PRG
VAR
    pub : HLTX.FB_HLTX_Publisher;
    bInit : BOOL;
END_VAR

IF NOT bInit THEN
    bInit := TRUE;
    pub.sDestination := '239.0.0.22';
    pub.uiPublisherId := 1;
    pub.tPublishingInterval := T#100MS;
    pub.AddReal(ADR(GVL.rTemperature));
    pub.AddBool(ADR(GVL.bRunning));
END_IF
pub.bEnable := TRUE;
pub();`;

// The story reads top to bottom: the problem, what it does, where it fits, how it installs, what was proven,
// and then the reference material (what is in it, what it refuses, what comes after).
const proof: [string, string][] = [
  ['Built', 'The library compiled with 0 errors and 0 warnings in the CODESYS 3.5.22.30 development system, and the example application built against it for a CODESYS Control for Linux SL device.'],
  ['Run on', 'The CODESYS Control for Linux SL 4.22.0.0 runtime in a container, in demo mode, with a 20 ms task. Two publishers, one in each encoding, seventeen fields each, on The Beast.'],
  ['Read by a decoder written from the spec', 'Every field equalled the PLC\'s own value, in both encodings, with no gap in the message sequence numbers.'],
  ['Read by open62541 1.4.9, a stack that is not ours', 'In the Variant encoding all 15 values checked equal, strings and arrays included. In RawData the 11 numeric scalars equal. That stack\'s RawData reader cannot read a longer string or any array at all.'],
  ['Read by HotLoop core', 'HotLoop\'s UADP subscriber, from HotLoop core\'s main branch (it is not in a core release yet, and the next one carries it), read both publishers live and checked 21 values equal, including the string, the TIME, both arrays and two counters that moved between reads. It refused nothing.'],
  ['Read by a second Go decoder', 'All 111 messages of each capture decoded, and every checked value was correct, in both encodings.'],
  ['What it costs the scan', 'About 10.6 microseconds added to a 20 ms cycle on average, which is 0.05 percent. A cycle that sends takes 10 to 100 microseconds. The longest send in the measured window was 14.3 ms, all of it in the operating system\'s send call, on a container on a busy 64-thread host. If a stall like that matters to your control logic, publish from its own lower priority task.'],
  ['Not run', 'A physical controller, any other runtime or CPU, multicast, a runtime that loses and regains its network, and the end of the two hour demo window. A small ARM controller can be ten to a hundred times slower than the host these numbers came from, so measure it on the target with the block\'s own timing outputs.'],
];

const wontDo: [string, string][] = [
  ['It won\'t block your scan.', 'The socket is non-blocking and the message is built in a fixed buffer. A socket error, a bad address, or a field list that does not fit becomes a state and a counter on the block, never a fault in your application.'],
  ['It won\'t fragment.', 'A message is at most 1472 bytes, so it fits one Ethernet frame. A field list that does not fit puts the block in an error state and sends nothing, instead of cutting your data.'],
  ['It won\'t encrypt.', 'This version sends in the clear. Message signing and encryption are not built, and the roadmap says so.'],
  ['It won\'t subscribe.', 'It publishes. The subscriber side is not part of this library.'],
];

const built: [string, string][] = [
  ['One block, called once per cycle', 'FB_HLTX_Publisher sends one NetworkMessage per publishing interval, with one DataSetMessage that carries every field you added.'],
  ['The types a PLC uses', 'BOOL, SINT, USINT, INT, UINT, DINT, UDINT, LINT, ULINT, REAL, LREAL, STRING and TIME, plus arrays of any of them but STRING.'],
  ['Two encodings', 'Variant, which any subscriber reads without a layout, and RawData, which is smaller and needs the receiver to know the layout.'],
  ['Unicast or multicast', 'A dotted address, a port, and for multicast a TTL and the interface to send from. Publisher id, writer group, dataset writer and the interval are inputs of the block.'],
  ['Counters that tell the truth', 'Messages sent, sends refused, publish slots skipped, the size of the last message, and the time the block spent in its last call and its longest.'],
  ['Nothing to license', 'It is Structured Text over SysSocket, which every CODESYS runtime with sockets has. No other library, no configurator.'],
];

const planned: [string, string][] = [
  ['Next', 'Timestamps, several DataSetMessages in one NetworkMessage, delta frames and keep-alives, WSTRING, and a per-field status.'],
  ['Not planned', 'Message security, chunked messages, the subscriber side, and an MQTT transport.'],
];
---

<Base
  title="HotLoop Transmitter: OPC UA PubSub from the PLC"
  description={R
    ? 'HotLoop Transmitter is a CODESYS library that publishes PLC values as OPC UA PubSub over UDP, written in Structured Text.'
    : 'HotLoop Transmitter is a CODESYS library that publishes PLC values as OPC UA PubSub over UDP, in Structured Text. Not released yet.'}
  ogAlt="HotLoop Transmitter, OPC UA PubSub from the PLC."
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop Transmitter',
      url: 'https://hotloop.io/transmitter/',
      description: 'A CODESYS library, written in Structured Text over SysSocket UDP, that publishes PLC values as OPC UA PubSub (UADP, OPC 10000-14).',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'CODESYS runtimes',
      license: 'https://hotloop.io/license/',
      ...(R ? { softwareVersion: TRANSMITTER.version, downloadUrl: `${TRANSMITTER.downloads}${TRANSMITTER.version}/HotLoopTransmitter-${TRANSMITTER.version}.library` } : {}),
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster">
        <span class="label">HotLoop Transmitter</span>
        {R ? <span class="chip ok">Released, {TRANSMITTER.version}</span> : <span class="chip warn">Not released yet</span>}
      </div>
      <h1>Put the process value on the wire from inside the PLC.</h1>
      <p class="lede">
        You want a PLC's values on the network as OPC UA PubSub, and the PLC has no PubSub library on it. Transmitter is a
        CODESYS library that fixes that: you add it to the project, call one function block once per cycle, and a UADP
        message goes out every publishing interval to a unicast address or a multicast group, the way Part 14 of the spec says.
        It needs no other library, no extra license, and no configurator. The consequence: a bare PLC can feed anything that
        subscribes to OPC UA PubSub, with a few lines of Structured Text.
      </p>
      {!R && (
        <div class="notice info">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
          <div>
            <strong>There is no release yet, and no file to download.</strong>
            <p>
              The library builds and runs on the CODESYS Control for Linux SL 4.22.0.0 runtime in a container, and what it sends was
              read back by decoders that are not ours. It has not run on a physical controller. Nothing here is installable until a
              version is tagged, and this page says so until then.
            </p>
          </div>
        </div>
      )}
      <div class="cluster">
        <a class="btn primary" href="#install">How it installs</a>
        <a class="btn" href="/releases/transmitter/">Release notes</a>
        <a class="btn" href="https://docs.hotloop.io/transmitter/overview/">Docs</a>
        <a class="btn" href="/products/">See the rest of the lineup</a>
      </div>
      <FamilyLine id="transmitter" />
    </div>
  </section>

  <section class="block" id="use">
    <div class="wrap grid grid-2 split">
      <div class="stack">
        <span class="label">What it does</span>
        <h2>Add the library, call one block.</h2>
        <p class="muted">
          Declare a publisher, add the variables you want out once at start, and call it every cycle. The block builds one message
          in a fixed buffer and sends it on a non-blocking socket, and the cost of a call is the cost of building one message,
          paid only on the cycles where one goes out. A bad address or a field list that does not fit becomes a state and a
          counter on the block, never a fault in your program, so the scan keeps scanning.
        </p>
        <p class="muted">
          It sends BOOL through LREAL, STRING and TIME, and arrays, in two encodings. Variant is read by any subscriber without a
          layout. RawData is smaller and needs the receiver to know the layout.
        </p>
      </div>
      <div class="stack">
        <pre><code>{snippet}</code></pre>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap grid grid-2 split">
      <div class="stack">
        <span class="label">Where it fits</span>
        <h2>It lives in the PLC, so it is Structured Text and not Go.</h2>
        <p class="muted">
          Every new HotLoop tool is written in Go unless there is a real reason. This is the reason: it has to run inside the PLC's
          own scan, as a library the programmer references from the project, and a CODESYS runtime runs Structured Text. The
          tools around it, the capture tool and the verifier, are Go.
        </p>
      </div>
      <div class="stack">
        <span class="label">Next to the rest of HotLoop</span>
        <h2>It publishes. The other end is somebody else's.</h2>
        <p class="muted">
          Transmitter only publishes: the subscriber side is not part of it. It sits on its own release line beside
          the rest of the <a href="/products/">lineup</a>. HotLoop core's subscriber reads it, from core's main branch, which is not in a core release yet. It is under the same HotLoop license as every product.
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap">
      <div class="section-head">
        <span class="label">How it installs</span>
        <h2>One library file in the CODESYS library repository.</h2>
        <p class="lede">
          {R
            ? `Download the library below and install it in the CODESYS IDE. This is version ${TRANSMITTER.version}.`
            : 'There is no file to download today, so these are the steps for when there is.'}
          You need a CODESYS development system, 3.5 SP22 or later, and a runtime whose target has the SysSocket component, which
          the CODESYS Control runtimes for Linux SL have.
        </p>
      </div>
      {R && (
        <div class="cluster">
          <a class="btn primary" href={`${base}${libFile}`}>Download {libFile}</a>
          <a class="btn" href={`${base}HotLoopTransmitter-${TRANSMITTER.version}.compiled-library`}>The compiled library</a>
          <a class="btn" href={`${base}SHA256SUMS`}>SHA256SUMS</a>
        </div>
      )}
      <ol class="steps">
        <li>Install <code>{libFile}</code> with Tools, Library Repository, Install.</li>
        <li>Open the application's Library Manager, Add Library, and pick HotLoop Transmitter. SysSocket and its interface libraries come along as dependencies.</li>
        <li>Declare an <code>HLTX.FB_HLTX_Publisher</code>, add your fields, and call it every cycle, as in the example above.</li>
        <li>Download to the controller. The destination has to be reachable from its network, and for multicast the switches have to carry the group.</li>
      </ol>
      <p class="muted note">
        The <code>.compiled-library</code> file is the same library without its source, for when you don't want the Structured
        Text visible in the Library Manager. The <a href="https://docs.hotloop.io/transmitter/install/">install page</a> in the docs
        lists every error the block can report, and what to do about each.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Proven, and not</span>
        <h2>What was run, and what it showed.</h2>
        <p class="lede">
          The full runs are on the <a href="https://docs.hotloop.io/transmitter/proof/">proof page</a>, and the timing on the
          <a href="https://docs.hotloop.io/transmitter/timing/">timing page</a>.
        </p>
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>Check</th><th>What</th></tr></thead>
          <tbody>
            {proof.map(([k, v]) => <tr><td class="mono">{k}</td><td data-label="What">{v}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">What is built</span>
        <h2>{R ? `What ${TRANSMITTER.version} ships.` : 'What is in the first version.'}</h2>
      </div>
      <div class="grid grid-3">
        {built.map(([h, b]) => <article class="card reveal"><h3>{h}</h3><p>{b}</p></article>)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">What it won't do</span>
        <h2>Four refusals, each on purpose.</h2>
      </div>
      <div class="grid grid-2">
        {wontDo.map(([h, b]) => <article class="card reveal"><h3>{h}</h3><p>{b}</p></article>)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Roadmap</span>
        <h2>What comes after.</h2>
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>When</th><th>What</th></tr></thead>
          <tbody>
            {planned.map(([v, w]) => <tr><td class="mono">{v}</td><td data-label="What">{w}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card cta reveal">
        <div class="stack">
          <span class="label">Licensing</span>
          <h2>Under the HotLoop Business Source License 1.1.</h2>
          <p class="muted">
            Like the rest of HotLoop. Home and lab use is free. Business use is free through <a href="https://embernet.ai">EmberNet</a>.
          </p>
        </div>
        <a class="btn primary" href="/license/">Read the license</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s7); }
  .page-hero h1 { max-width: 22ch; }
  .page-hero .notice { max-width: 68ch; }
  .split { align-items: start; gap: var(--hl-s8); }
  pre { overflow-x: auto; }
  .steps { display: grid; gap: var(--hl-s3); padding-left: 1.4em; max-width: 78ch; color: var(--hl-ink-soft); }
  .note { max-width: 72ch; margin-top: var(--hl-s5); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--hl-s6); justify-content: space-between; align-items: center; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .cta .stack { max-width: 62ch; }
</style>
