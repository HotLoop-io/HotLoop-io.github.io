---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LeadCard from '../components/LeadCard.astro';
import FamilyLine from '../components/FamilyLine.astro';
import JsonLd from '../components/JsonLd.astro';
import Backpressure from '../components/Backpressure.astro';
import CardDetail from '../components/CardDetail.astro';

const nodes = await getCollection('nodes');
const helmFlow = `helm repo add hotloop-flow https://hotloop.io/hotloop-flow/
helm install line3-flows hotloop-flow/hotloop-flow`;
const level = (l: string) => nodes.filter((n) => n.data.level === l).length;

// Absolute numbers only: a side-by-side table moves every time the box changes.
const bench = [
  ['Program size, one self-contained file', '41.7 MB'],
  ['Container image', '45.6 MB'],
  ['Start to answering its first request', '0.05 s'],
  ['Memory in use, idle', 'about 16 MiB'],
  ['Memory, peak under load', 'about 28 MiB'],
  ['Web requests through a five-node flow', 'over 13,000 a second'],
  ['Web latency, typical / worst case', 'under half a millisecond / a few milliseconds'],
  ['Engine, five-node chain, no I/O', 'about 2 to 3 microseconds a message'],
];

// The head-to-head from 2026-08-08: same flow file, same load, same machine.
const versus = [
  ['Image size', '45.64 MB', '717 MB', '16×'],
  ['Throughput', '3,460 req/s', '1,290 req/s', '2.7×'],
  ['Latency p50', '1.03 ms', '4.61 ms', '4.5×'],
  ['Latency p99', '16.72 ms', '23.14 ms', '1.4×'],
  ['Cold start', '2.1 to 2.3 s', '4.6 to 5.5 s', '~2.3×'],
];

// The published arm64 image as a pod on one Raspberry Pi 5, measured 2026-10-22.
const pi5 = [
  ['Start to answering its first request', 'under half a second'],
  ['Memory in use, idle', 'about 88 MiB'],
  ['Web requests through a five-node flow', 'over 13,000 a second'],
  ['Web latency, typical / worst case', 'about half a millisecond / under 3 milliseconds'],
  ['Engine, five-node chain, no I/O', 'about 8 microseconds a message'],
  ['Ten minutes flat out', 'about 11,400 requests a second, steady'],
];

const different = [
  ['Runtime', 'One thread for everything', 'Every node on its own thread'],
  ['Back-pressure', 'None, the queue grows until the box dies', 'Bounded inboxes, four policies'],
  ['Message cloning', 'Branches can quietly corrupt each other', 'Every recipient gets its own copy'],
  ['Function sandbox', 'Not a security boundary, by its own docs', 'Locked in a box with no access to the host'],
  ['Plugins', 'Packages that run inside the same process', 'Signed, sandboxed plugins, refused unless the key is trusted'],
  ['Running commands', 'Any command, through a shell by default', 'Off until you allow specific commands, and no shell at all'],
  ['File access', 'Any path the process can reach', 'Fenced to its own volume'],
  ['Stored credentials', 'Weak encryption', 'Strong, modern encryption'],
  ['Shared state', 'Get and set', 'Get, set, and safe counters and updates'],
  ['Saving a flow', 'Written once', 'Written safely, with three backups deep'],
  ['Configuration', 'A script you edit', 'A plain, declarative file'],
  ['Sign-in', 'Off by default', 'Refuses to start without it'],
  ['Metrics', 'Not compared', 'Built in, per node'],
  ['Defining a node', 'Two hand-written files that must match', 'One definition'],
];

const notDone = [
  ['Hardware coverage.', 'Modbus TCP, OPC UA, S7, EtherNet/IP, and Sparkplug B nodes ran against simulators, a real broker, and bare metal (2026-11-17). Next: Modbus RTU, Modbus over TLS, OPC UA events, history, method calls and browse, S7 timers and counters, and PCCC controllers.'],
  ['HotLoop nodes.', 'Flows can follow HotLoop\'s live feed, read state, run scripts, and apply recipes, and the write nodes can go through HotLoop\'s write gate. Next: an https HotLoop with a private CA.'],
  ['AI agents.', 'Flows serve tools to agents and call tools on other servers. Next: OAuth, stdio servers, resources, prompts, sampling, and a tool\'s output schema.'],
  ['Plugins.', 'Signed, sandboxed plugins are out and were run on bare metal (2026-11-17).'],
  ['The editor.', 'Rebuilt in HotLoop\'s colors and type, with browser tests that pass in Chrome.'],
];

// What Flow does, grouped by the question a plant person asks. Every card is a title
// and a sentence or two. The long form of each is in the detail block under the groups,
// and in Flow's own README and docs.
type Card = { h: string; b: string; chip?: string };
const groups: { id: string; label: string; h: string; cols: 3 | 4; cards: Card[] }[] = [
  {
    id: 'ship', label: 'Ship changes safely', h: 'Every deploy is a record, and a flow can be tested before it ships.', cols: 4,
    cards: [
      { h: 'Deploy records, diff and rollback', b: 'Who, when, why, and the flow file byte for byte, with credentials encrypted as they stood. A diff reads node by node, and rollback redeploys an old record. "Who changed line 3 and put it back" is a command, not an archaeology project.' },
      { h: 'Flows as code', b: 'A command line prints the diff and deploys against the revision it came from, so a race is a red pipeline. A pipeline holds a token that can read and deploy, nothing else.' },
      { h: 'Tests and a deploy gate', b: 'A test file runs on the real runtime. Turn on the gate and a deploy that fails the suite is refused with the whole report, so a broken flow never reaches the plant.' },
      { h: 'Partial deploy', b: 'A save restarts the nodes that changed. MQTT sessions, listeners and Delay queues on everything else keep running.' },
    ],
  },
  {
    id: 'see', label: 'See what happened', h: 'Click a message and see the path it took.', cols: 3,
    cards: [
      { h: 'Tracing and replay', b: 'The canvas lights up the path a message took, with timing and payload at every hop. Replay it into a draft of the flow, or turn the trace into a test.' },
      { h: 'Traces to your collector', b: 'Every hop can go to your own observability collector as a span, with a bounded buffer, so tracing never becomes the outage.' },
      { h: 'Metrics and an audit log', b: 'Metrics per node for your dashboards. Logins, deploys, refusals and rollbacks go to an audit log, each saying who, from where, and what.' },
    ],
  },
  {
    id: 'ride-out', label: 'Ride out the bad hour', h: 'A slow historian or a chatty sensor is a graph, not an outage.', cols: 4,
    cards: [
      { h: 'Bounded inboxes', b: 'Every inbox has a ceiling and a policy per node: block, drop the newest, drop the oldest, or raise it to a Catch node. Every message that does not fit is counted.' },
      { h: 'Durable wires', b: 'Mark a wire durable and, when the node behind it stops answering, messages go to disk in order and drain when it returns. We killed a real InfluxDB for ten minutes and no rows went missing or doubled.' },
      { h: 'Context that survives a restart', b: 'Flow, global and node context are kept on disk, so a restart no longer wipes them.' },
      { h: 'One thread per node', b: 'Each node runs on its own lightweight thread. A CPU-heavy Function node costs you a core, not the editor and every other flow on the box.' },
    ],
  },
  {
    id: 'plant', label: 'Talk to the plant floor', h: 'Native nodes for the protocols a plant already runs.', cols: 4,
    cards: [
      { h: 'Modbus TCP and OPC UA', b: 'Modbus read and write, and OPC UA read, subscribe, and write.' },
      { h: 'S7 and EtherNet/IP', b: 'Read and write for Siemens and Allen-Bradley controllers, tested on bare metal (2026-11-17). A new controller is still a commissioning job, so check a value you already know.' },
      { h: 'Sparkplug B', b: 'As an edge node and as a host, checked in both directions and against a real broker.' },
      { h: 'MQTT 5, TLS and Node-RED\'s schedules', b: 'MQTT 5 with properties and the last will, TLS, HTTP request and MQTT, and Inject on a crontab that fires when Node-RED\'s would.' },
    ],
  },
  {
    id: 'reach', label: 'Reach the rest of the plant', h: 'Talk to HotLoop, let an AI agent call a flow, and catch a wrong-shaped message early.', cols: 4,
    cards: [
      { h: 'HotLoop nodes and gated writes', b: 'Follow HotLoop\'s live feed, read state, run scripts, and apply recipes. The write nodes can send through HotLoop\'s write gate, and a refused write never reaches the equipment.' },
      { h: 'Flows as agent tools', b: 'A flow can serve itself to an AI agent as a tool, and a flow can call tools on any other agent server. A token is required, and every call is audited under the caller.' },
      { h: 'Signed WebAssembly plugins', b: 'A plugin is a signed, sandboxed file, not a package pulled from the internet. Unsigned ones refuse to load, and with no trusted keys nothing loads at all.' },
      { h: 'Typed wires and the Inject check', b: 'Give the json node a schema and a wrong-shaped value goes to Catch with every bad field named. A deploy is refused when two ends of a wire can never agree.' },
    ],
  },
  {
    id: 'flowlab', label: 'FlowLab', h: 'A second way to run a tab, for test benches and data loggers, with 37 node types of its own beside the ones for messages.', cols: 3,
    cards: [
      { h: 'Diagrams with loops and an error wire', b: 'In a diagram each node runs once, when every wired input has a value, and nodes with no wire between them run at the same time. While and for loops carry a value from one pass to the next, and an error travels on a wire of its own. Existing flows run exactly as they did.' },
      { h: 'A panel and a debugger', b: 'A panel with controls, indicators and charts that opens on a phone, and a run bar with highlight execution, probes, breakpoints and step.' },
      { h: 'Analysis, DAQ and TDMS', b: 'Statistics, integral, derivative and filter nodes, a node that reads NI hardware, a durable MQTT output, and a TDMS log you can open in NI\'s tools.' },
    ],
  },
  {
    id: 'locked', label: 'Locked down by default', h: 'It refuses to start without a login in front of it.', cols: 3,
    cards: [
      { h: 'No login is a startup error', b: 'Turning authentication off takes a deliberate setting, and the editor wears a no-login badge while it is off.' },
      { h: 'Two-factor and lockouts', b: 'Two-factor sign-in is free. Five wrong passwords lock an account from that address for fifteen minutes, and sessions survive a restart.' },
      { h: 'Strong credential storage', b: 'Credentials are encrypted with modern, authenticated encryption, and deploy records never hand them out, encrypted or not.' },
      { h: 'Commands off, files fenced', b: 'The exec node ships disabled until an operator allows specific commands, with no shell. File nodes are fenced to the volume.' },
      { h: 'A sandbox with nothing to reach', b: 'The Function node runs with no access to the host, no files, and no network. Plugins run signed, with a memory ceiling and a timeout.' },
      { h: 'One small program', b: 'A 41.7 MB self-contained program that idles at about 16 MiB and answers its first request in 0.05 s. It runs on a Raspberry Pi 5.' },
    ],
  },
];
---

<Base
  title="HotLoop Flow: a Node-RED alternative in Go"
  description="A Node-RED-compatible flow engine in one static Go binary, with bounded queues and a thread per node. Free for home and lab, and its source is public."
  ogAlt="HotLoop Flow, a flow engine in one static Go binary."
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop Flow',
      url: 'https://hotloop.io/flow/',
      description:
        'A flow engine in one static Go binary that reads Node-RED v1 flow files, with bounded queues, a thread per node, and a security posture built for plant floors.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux',
      license: 'https://hotloop.io/license/',
      isAccessibleForFree: true,
      softwareVersion: '2.16.3',
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster"><span class="label">HotLoop Flow</span><span class="chip ok">License: HotLoop Source 1.0</span></div>
      <h1>Wire the plant. Review it like code.</h1>
      <p class="lede">
        A flow engine for the plant floor, in one static Go binary with its own editor. Every deploy is a record you
        can diff and roll back, a trace shows where a message went, and a wire can ride out an outage. It reads your
        existing <code>flows.json</code> too, so you can bring what you have.
      </p>
      <div class="notice info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
        <div>
          <strong>HotLoop Flow 2.16.3 is out. The CPU a dashboard chart costs no longer grows the longer Flow runs: a plant flow of about 13,700 nodes that climbed from about 130 to about 420 millicores in two hours now stays flat. Nothing in your flows, settings or chart changes.</strong>
          <p>
            The code is at <a href="https://github.com/HotLoop-io/hotloop-flow">github.com/HotLoop-io/hotloop-flow</a>. It runs on
            amd64 and arm64, so every box pulls its own (2.16.3 is amd64 only, so on arm64 stay on 2.16.1 until 2.16.4), and there is a chart for Kubernetes. Upgrading is a plain
            image bump, and the <a href="/releases/flow/#flow-2.16.3">release notes</a> say what each version changes before you do it.
            Flow is under the HotLoop Source License Agreement 1.0, and home and lab use is free.
          </p>
        </div>
      </div>
      <div class="cluster">
        <a class="btn primary" href="https://docs.hotloop.io/flow/install/">Install it</a>
        <a class="btn" href="/integrations/#flow-nodes">Browse the {nodes.length} nodes</a>
        <a class="btn" href="/releases/flow/">Release notes</a>
        <a class="btn" href="https://docs.hotloop.io/flow/overview/">Docs</a>
      </div>
      <FamilyLine id="flow" />
    </div>
  </section>

  <section class="block" id="what-it-does">
    <div class="wrap">
      <div class="section-head">
        <span class="label">What Flow does</span>
        <h2>Ship it, watch it, and let it ride out a bad hour.</h2>
        <p class="lede">
          Each card is the short version. The full text for each is in <a href="https://docs.hotloop.io/flow/overview/">the docs</a>
          and the <a href="/releases/flow/">release notes</a>.
        </p>
      </div>
      {groups.map((g) => (
        <div class="group" id={g.id}>
          <h3 class="group-title">{g.label}</h3>
          <p class="group-sub">{g.h}</p>
          <ul class="rows">
            {g.cards.map((c) => (
              <li>
                <div class="rh"><strong>{c.h}</strong></div>
                <p set:html={c.b} />
              </li>
            ))}
          </ul>
        </div>
      ))}
      
    </div>
  </section>

  <section class="block" id="editor">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The editor</span>
        <h2>Wire it, review it, follow a message down the wires.</h2>
        <p class="lede">
          Light or dark, it follows your system. These are real screenshots of the running editor on an oven line with two
          deployments behind it, retaken when the editor changes.
        </p>
      </div>
      <div class="flow-shots">
        <figure>
          <img class="flow-shot light" src="/flow/editor.png" width="1440" height="1000" loading="lazy" alt="The Flow editor on an oven line: the canvas, the deployment history, and the debug and runtime panels" />
          <img class="flow-shot dark" src="/flow/editor-dark.png" width="1440" height="1000" loading="lazy" alt="The Flow editor on an oven line, in dark" />
          <figcaption>The canvas is what's running. The debug dock and the Runtime table under it say what every node is doing.</figcaption>
        </figure>
        <figure>
          <img class="flow-shot light" src="/flow/review.png" width="1440" height="1000" loading="lazy" alt="The review panel listing one changed node, with a note box, beside the canvas with that node outlined" />
          <img class="flow-shot dark" src="/flow/review-dark.png" width="1440" height="1000" loading="lazy" alt="The review panel in dark" />
          <figcaption>Deploy shows the change on the canvas and in words, and asks for a note that lands in the history.</figcaption>
        </figure>
        <figure>
          <img class="flow-shot light" src="/flow/debug.png" width="1440" height="1000" loading="lazy" alt="A traced message lit across the canvas with the time each node spent on it, and the debug dock below" />
          <img class="flow-shot dark" src="/flow/debug-dark.png" width="1440" height="1000" loading="lazy" alt="A traced message in dark" />
          <figcaption>Click Trace on a debug line and the path that message took lights up, hop by hop.</figcaption>
        </figure>
        <figure>
          <img class="flow-shot light" src="/flow/signin.png" width="800" height="500" loading="lazy" alt="The sign-in card" />
          <img class="flow-shot dark" src="/flow/signin-dark.png" width="800" height="500" loading="lazy" alt="The sign-in card in dark" />
          <img class="flow-shot light" src="/flow/dashboard-signin.png" width="800" height="500" loading="lazy" alt="What a runtime says when the dashboard signs people in and the page was opened another way" />
          <img class="flow-shot dark" src="/flow/dashboard-signin-dark.png" width="800" height="500" loading="lazy" alt="The dashboard notice in dark" />
          <figcaption>Flow won't start unlocked. When the EmberCORE dashboard signs people in, a runtime opened any other way says to come in through the dashboard.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Install it</span>
        <h2>One image, one volume, and an admin account before it will start.</h2>
        <p class="lede">
          Flow refuses to run unlocked, so every install sets an admin password and a credential secret first. Keep the
          credential secret somewhere that is not the box: every broker and database password Flow stores is unreadable
          without it, which is the point.
        </p>
      </div>
      <div class="grid grid-2">
        <article class="card reveal">
          <h3>Podman</h3>
          <p class="muted">One image, one volume, and a few lines to set the admin account. Service files that follow the stable release, and the full steps, are on <a href="https://docs.hotloop.io/flow/install/">the install page</a>.</p>
        </article>
        <article class="card reveal">
          <h3>k3s with Helm</h3>
          <pre><code>{helmFlow}</code></pre>
          <p class="muted">The chart makes the admin password and the credential secret on first install and keeps them on every upgrade. One release is one instance, on purpose.</p>
        </article>
      </div>
    </div>
</section>

  <section class="block" id="numbers">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The numbers</span>
        <h2>A 41.7 MB program that answers in 0.05 s, with the limits stated up front.</h2>
        <p class="lede">
          Measured on a desktop Linux machine, three runs of each command, and the range is what's printed. Flow prints
          absolute numbers only, because a side-by-side table moves every time the box changes and ends up describing the
          box more than Flow. You can run the same benchmark on your own hardware.
        </p>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Measure</th><th>Flow</th></tr></thead>
          <tbody>
            {bench.map(([k, a]) => (
              <tr><td>{k}</td><td class="num win">{a}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pi5" id="pi5">
        <h3>On a Raspberry Pi 5</h3>
        <p class="muted">
          The same flow and the same commands, running the published arm64 image on one Pi 5 with 8 GB. Three runs, and
          the range is what's printed.
        </p>
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th>Measure</th><th>Flow on a Pi 5</th></tr></thead>
            <tbody>
              {pi5.map(([k, a]) => (
                <tr><td>{k}</td><td class="num win">{a}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="muted">
          The ten minute row is the honest one for a box that stays loaded: the board heated up and throttled its clock,
          and Flow still held steady. Idle memory runs higher than the desktop figure above, and the
          method is in the
          <a href="https://github.com/HotLoop-io/hotloop-flow/blob/main/docs/bench/README.md#results-on-a-raspberry-pi-5">bench docs</a>.
        </p>
      </div>

      <div class="caveats">
        <h3>How to read these figures.</h3>
        <p class="muted">Four notes on what the numbers measure.</p>
        <ol>
          <li>
            <strong>The web number includes the whole web stack, on purpose</strong>, since that is what a client of
            your flow sees. It is not a scheduler benchmark. The engine row is the scheduler, with no I/O in the path.
          </li>
          <li>
            <strong>The tail moves more than the median.</strong> Under saturation every runtime queues, and queueing
            owns the worst case, so it wanders between runs while the typical latency barely does.
          </li>
          <li>
            <strong>The engine's peak memory is a burst, not a resting state.</strong> That row fires 200,000 messages at
            once and the bounded inboxes hold the rest back. Feed it at a sensor's pace and memory sits where the idle rows say.
          </li>
          <li>
            <strong>A desktop is not a Pi.</strong> The Pi 5 is measured above. The image has grown over the releases as
            the plant nodes, tracing, the state store, the HotLoop and agent nodes, schema checking, plugins and FlowLab
            came in.
          </li>
        </ol>
        <p class="muted">
          Memory is the process's own resident memory, not what a container tool charges the container, so the figure
          is the same whichever tool reads it.
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="head-to-head">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Flow against Node-RED</span>
        <h2>The same flow file on both runtimes.</h2>
        <p class="lede">
          We deployed the same five-node flow file to Flow and to the latest Node-RED, unchanged, and ran the same load
          on the same machine in the same sitting. Flow came out smaller, faster and quicker to start. The table and
          every condition behind it are below.
        </p>
      </div>
      <CardDetail label="The table and every caveat behind it">
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Measure</th><th>Flow</th><th>Node-RED</th><th>Ratio</th></tr></thead>
          <tbody>
            {versus.map(([k, a, b, r]) => (
              <tr><td>{k}</td><td class="num win">{a}</td><td class="num">{b}</td><td class="num">{r}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="caveats">
        <h3>Three things that table does not say.</h3>
        <ol>
          <li>
            <strong>Cold start includes roughly two seconds of container start that both runtimes pay</strong>, so the
            real gap between the two programs is smaller than that row implies.
          </li>
          <li>
            <strong>The throughput figure includes the whole web stack, on purpose</strong>, since that is the only
            surface both present identically. It is not a measurement of either scheduler in isolation.
          </li>
          <li>
            <strong>The worst-case gap is far narrower than the typical gap</strong>. Under
            saturation both runtimes queue, queueing dominates the tail, and the median is the only column where
            per-request cost actually shows up.
          </li>
        </ol>
        <p class="muted">
          Two more notes. The throughput, latency and cold start rows are from a run on
          2026-08-08, on an earlier build of Flow, so don't divide them by the newer absolute numbers above. The image
          row is the current image against the Node-RED image from that run. When we ran it, Flow was 25.1 MB
          and the gap was 29×, and Flow has grown since as it gained features.
        </p>
        <p class="muted">
          Memory isn't in this table, on purpose. Those numbers came off a container tool that reports what
          the kernel charges the container, not what the process holds, and nobody could reproduce them.
          A ratio across two methods is exactly the mistake that got the old numbers pulled.
        </p>
      </div>
      </CardDetail>
    </div>
  </section>

  <section class="block" id="from-node-red">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Coming from Node-RED</span>
        <h2>Bring your Node-RED flows.</h2>
        <p class="lede">
          Flow reads your existing flows.json and runs it on a runtime built for the plant floor: a bounded queue on
          every wire, a thread for every node, a Function node sealed off from the host, and authenticated encryption on
          stored credentials. The
          <a href="https://docs.hotloop.io/flow/migrating-from-node-red/">migration guide</a> walks a flow across, and the
          compatibility table below lists every node and every difference. Community nodes are the one thing that
          doesn't come along, because they need Node.js.
        </p>
      </div>
      <div class="grid grid-2">
        <LeadCard cls="t-md" h="A ceiling on every queue." b="Every inbox is bounded, with a policy per node: block, drop the newest, drop the oldest, or raise it to a Catch node. A chatty sensor and a slow database can't run the box out of memory." />
        <article class="card reveal"><h3 class="t-md">A thread for every node.</h3><p>Each node runs on its own thread, in order within the node and in parallel across nodes, so one CPU-heavy Function node never freezes the editor or another flow.</p></article>
        <article class="card reveal"><h3 class="t-md">A Function node sealed off from the host.</h3><p>Function code runs with no access to the host, its files or the network.</p></article>
        <article class="card reveal"><h3 class="t-md">Credentials that detect tampering.</h3><p>Stored credentials use modern authenticated encryption under a proper key derivation, so a file somebody altered fails to decrypt.</p></article>
      </div>
      <CardDetail label="The detail, with the sources">
        <div id="node-red-detail" class="stack">
          <div><h4>There is no back-pressure.</h4><p>Node-RED, by default, hands every message to the next node through a queue, and nothing puts a ceiling on that queue. A fast source outruns a slow sink, the queue grows, and the pod runs out of memory and gets killed with nothing in the log to explain it. Every inbox in Flow is bounded, with a policy per node: block, drop the newest, drop the oldest, or raise it to a Catch node and let the flow decide.</p></div>
          <div><h4>It is single-threaded.</h4><p>One event loop carries the runtime, the editor API, the websocket fan-out, and every node's I/O. One CPU-heavy Function node stalls all of it, including the editor you are using to find out why it stalled. In Flow, every node instance gets its own thread, ordered within a node and parallel across nodes.</p></div>
          <div><h4>The Function node's sandbox is not a boundary.</h4><p>Node-RED's Function node runs your code in <code>node:vm</code>. That is not our accusation, it is Node's own documentation: <a href="https://nodejs.org/api/vm.html">“The <code>node:vm</code> module is not a security mechanism. Do not use it to run untrusted code.”</a> Node-RED's own guide says an unsecured editor is only suitable on a trusted network, and anyone who can deploy a flow can run commands on the box, which is fine on a Pi in a workshop and not fine on a customer's plant floor. It is not hypothetical either: <a href="https://nvd.nist.gov/vuln/detail/CVE-2025-41656">CVE-2025-41656</a> is unauthenticated remote command execution, rated critical, in Pilz's IndustrialPI 4 firmware, because authentication for the Node-RED server on it was not configured by default. That is a CVE in Pilz's product, not in Node-RED, and Node-RED's own guide says the editor is not secured by default.</p></div>
          <div><h4>Credentials are weakly protected.</h4><p>They are encrypted with AES-256-CTR keyed by a raw SHA-256 of your secret. CTR has no MAC, so anyone who can write the credentials file on a shared volume can flip chosen plaintext bits, which turns “can write a file” into “can change a broker password to one they picked.” And plain SHA-256 is not a key derivation function. There is no CVE on either of those, and both are still real.</p></div>
        </div>
      </CardDetail>
      <Backpressure />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Compared with Node-RED, concretely</span>
        <h2>The same idea, built for production.</h2>
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>Area</th><th>Node-RED</th><th>Flow</th></tr></thead>
          <tbody>
            {different.map(([k, a, b]) => <tr><td>{k}</td><td data-label="Node-RED">{a}</td><td data-label="Flow">{b}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="prose muted after">
        Flow is deliberately not identical. Node-RED hands the first recipient on a wire the original message and
        only clones for the rest, so two branches that each think they own their message can quietly corrupt each
        other, and which one breaks depends on the order you wired them. Every recipient in Flow gets its own copy.
        A small message costs 411 to 453 ns to copy. A 1 MiB binary payload would cost 128 to 156 µs per recipient,
        so those travel shared and immutable instead, at 250 to 279 ns, which is exactly where copying would have
        hurt. Every deliberate difference is written down in the compatibility matrix, so none of them is a
        surprise on a live line.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Compatibility</span>
        <h2>{nodes.length} node types, and each one says how close it is to Node-RED.</h2>
        <p class="lede">
          A node that is partially compatible and silent about how is worse than one that is obviously absent,
          because the flow appears to work and quietly does the wrong thing. So a test fails the build if a node
          does not say what is missing.
        </p>
      </div>
      <div class="grid grid-4">
        <div class="card"><div class="mono big">{level('full')}</div><h3 class="t-md">Full</h3><p>Behaves as the Node-RED node of the same type does.</p></div>
        <div class="card"><div class="mono big">{level('partial')}</div><h3 class="t-md">Partial</h3><p>A subset. The notes say exactly which parts are missing.</p></div>
        <div class="card"><div class="mono big">{level('divergent')}</div><h3 class="t-md">Divergent</h3><p>Deliberately different, and the notes say why.</p></div>
        <div class="card"><div class="mono big">{level('flow-only')}</div><h3 class="t-md">Flow only</h3><p>No Node-RED counterpart.</p></div>
      </div>
      <div class="grid grid-2 after">
        <div class="card"><h3 class="t-md">Not supported at all: community nodes</h3><p>They are npm packages that need Node.js, so they don't run in Flow. The plant nodes most flows lean on run natively.</p></div>
        <div class="card"><h3 class="t-md">JSONata, checked against the published examples</h3><p>Every <code>jsonata</code> property runs on our own JSONata engine, which passes 1,673 of the 1,686 published test cases. The 13 misses are listed in the repository.</p></div>
      </div>
      <p class="after"><a class="btn" href="/integrations/#flow-nodes">Browse all {nodes.length} nodes</a></p>
    </div>
  </section>

  <section class="block" id="release-notes">
    <div class="wrap">
