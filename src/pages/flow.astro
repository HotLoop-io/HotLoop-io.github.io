---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FamilyLine from '../components/FamilyLine.astro';
import JsonLd from '../components/JsonLd.astro';
import Backpressure from '../components/Backpressure.astro';

const nodes = await getCollection('nodes');
const level = (l: string) => nodes.filter((n) => n.data.level === l).length;

// Straight from the numbers table in Flow's own README and docs/bench. Absolute
// numbers only: Flow's repository dropped the side-by-side table on purpose,
// because it moves every time the box changes.
const bench = [
  ['Binary, linux/amd64, static', '22.0 MB'],
  ['Image, 2.2.0 amd64, as Podman reports it', '39.1 MB'],
  ['Start to answering its first request', '0.05 s'],
  ['RSS, idle', '16.4 to 16.7 MiB'],
  ['RSS, peak under the HTTP load', '26.4 to 28.5 MiB'],
  ['HTTP, five-node flow, 8 connections', '13.0k to 15.3k req/s'],
  ['HTTP latency p50 / p99', '0.39 to 0.41 ms / 1.78 to 4.03 ms'],
  ['Engine, five-node chain, no I/O', '2.20 to 3.11 µs a message'],
];

const different = [
  ['Runtime', 'Node.js, one event loop', 'Go, goroutine per node'],
  ['Back-pressure', 'None, unbounded queue', 'Bounded inbox, four policies'],
  ['Message cloning', 'First recipient aliases the sender', 'Every recipient gets a copy'],
  ['Function sandbox', 'node:vm, explicitly not a boundary', 'goja with no host bindings. A WASM host with a hard memory ceiling is built and tested, but no node uses it yet'],
  ['exec node', 'Any command, through a shell by default', 'Disabled until allowlisted, and no shell at all'],
  ['File nodes', 'Any path the process can reach', 'Scoped to the volume, symlinks resolved'],
  ['Credentials', 'AES-256-CTR, SHA-256 as the key', 'AES-256-GCM, Argon2id'],
  ['Context API', 'get, set', 'get, set, CompareAndSwap, Increment, Update'],
  ['Flow file writes', 'Temp file, fsync, rename', 'Temp file, fsync, rename, fsync the directory, three backups deep'],
  ['Config', 'settings.js, executable JavaScript', 'Declarative YAML'],
  ['Auth', 'Off by default', 'Refuses to start without it'],
  ['Metrics', 'Not compared', 'Prometheus at /metrics, per node'],
    ['Node definition', 'A .js plus a hand-written .html twin', 'One Go descriptor'],
];

const notDone = [
  ['A physical PLC.', 'Modbus TCP, OPC UA, S7, EtherNet/IP and Sparkplug B nodes are built and were tried against simulators and a real broker. S7 and EtherNet/IP have only met simulators, and none of them has met a Siemens CPU or a Logix controller. Modbus RTU, Modbus over TLS, OPC UA events, history, method calls and browse, S7 timers and counters, and PCCC controllers are not done.'],
  ['HotLoop nodes.', 'Entity changes in, entity state, call a script, apply a recipe, with every command through HotLoop’s write gate. Not built. Until it is, a Flow node that writes to equipment goes straight to the device and not through the gate.'],
  ['Plugins without npm.', 'The WASM host with a hard memory ceiling exists and no node uses it. The plugin format, the capability grants and the signing are not built. Community nodes stay unsupported, because they are npm packages.'],
  ['Typed wires and MCP.', 'Schemas on ports, flows served as MCP tools and an MCP client node are all planned and none of them is built.'],
  ['A real Pi.', 'The durable store’s writes per hour are measured on x86 under WSL. A Pi 4 and a Zero 2 W have not run it yet, and an SD card is the first place a context store would show a bug.'],
  ['The editor.', 'It is hand-built TypeScript and it does not look like the rest of HotLoop yet. A rewrite comes last, after a design pass, and the browser tests are the bar it has to clear.'],
];
---

<Base
  title="HotLoop Flow: a Node-RED alternative in Go"
  description="A Node-RED-compatible flow engine in one static Go binary, with bounded queues and a goroutine per node. Free for home and lab and for business via EmberNET."
  ogAlt="HotLoop Flow, a flow engine in one static Go binary."
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop Flow',
      url: 'https://hotloop.io/flow/',
      description:
        'A flow engine in one static Go binary that reads Node-RED v1 flow files, with bounded queues, a goroutine per node, and a security posture built for plant floors.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux',
      license: 'https://hotloop.io/license/',
      isAccessibleForFree: true,
      softwareVersion: '2.2.0',
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster"><span class="label">HotLoop Flow</span><span class="chip ok">License: BSL 1.1</span></div>
      <h1>Node-RED's idea, with a runtime that does not fall over.</h1>
      <p class="lede">
        A flow engine in Go, one static binary, with its own editor and a scheduler that holds up when a sensor
        talks faster than the thing reading it. Point it at your <code>flows.json</code> and it runs. What you get
        for switching: a runtime one chatty sensor can't OOM-kill, that flat refuses to start without a login in
        front of it.
      </p>
      <div class="notice info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
        <div>
          <strong>HotLoop Flow 2.2.0 is out, and it is the first release under the Business Source License.</strong>
          <p>
            The code is at <a href="https://github.com/HotLoop-io/hotloop-flow">github.com/HotLoop-io/hotloop-flow</a>, and
            the image is <code>ghcr.io/hotloop-io/hotloop-flow</code>. The image has the tags <code>2.2.0</code>, <code>2.2</code> and <code>2</code>, and the chart is at
            <code>https://hotloop.io/hotloop-flow/</code>. 2.1.0 and everything before it stay under the license they
            shipped with. From 2.2.0 on Flow is under the same HotLoop Business Source License 1.1 as the rest of the
            lineup: free for home and lab, and free for business through <a href="https://embernet.ai">EmberNET</a>.
            Version 0.1.0 was published as Emberwire, and 2.0.0 does not read what the old names wrote. Read the
            <a href="/releases/flow/">release notes</a> before you upgrade.
          </p>
        </div>
      </div>
      <div class="cluster">
        <a class="btn primary" href="https://docs.hotloop.io/flow/install/">Install it</a>
        <a class="btn" href="/integrations/#flow-nodes">Browse the {nodes.length} nodes</a>
        <a class="btn" href="/releases/flow/">Release notes</a>
        <a class="btn" href="https://docs.hotloop.io/flow/overview/">Docs</a>
      </div>
      <FamilyLine id="flow" />
    </div>
  </section>

  <section class="block" id="numbers">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The numbers</span>
        <h2>Absolute numbers, with the limits stated up front.</h2>
        <p class="lede">
          Linux under WSL2, 24 CPUs (a Ryzen 9 7900X), 2026-10-02, the native binary built from <code>main</code>, three
          runs of each command, and the range is what's printed. The image row is the published 2.2.0 image, read on
          2026-10-20. Flow's repository prints absolute numbers only, because a side-by-side table moves every time the
          box changes and ends up describing the other thing more than this one.
        </p>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Measure</th><th>Flow</th></tr></thead>
          <tbody>
            {bench.map(([k, a]) => (
              <tr><td>{k}</td><td class="num win">{a}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="caveats">
        <h3>Now, walking our own numbers back.</h3>
        <p class="muted">A benchmark table with no caveats under it is marketing wearing a lab coat. These figures are not allowed to say four things.</p>
        <ol>
          <li>
            <strong>The HTTP number includes the whole HTTP stack, on purpose</strong>, since that is what a client of
            your flow sees. It is not a scheduler benchmark and should not be quoted as one. The engine row is the
            scheduler, with no I/O in the path.
          </li>
          <li>
            <strong>The tail moves more than the median.</strong> Under saturation every runtime queues, and queueing
            owns p99, so p99 wanders between runs while p50 barely does.
          </li>
          <li>
            <strong>The engine's peak heap is a burst, not a resting state.</strong> That row fires 200,000 messages at
            once and the bounded inboxes hold the rest back. Feed it at a sensor's pace and memory sits where the RSS
            rows say.
          </li>
          <li>
            <strong>WSL2 is not a Pi.</strong> A Pi 4 and a Zero 2 W have not run it yet, and the image grew from 32.1 MB
            at 2.1.0 to 39.1 MB at 2.2.0 with the plant nodes, tracing and the SQLite state store, without anyone
            splitting the growth between them.
          </li>
        </ol>
        <p class="muted">
          Memory is the process's own resident memory, read from <code>/proc</code>. It is not what
          {' '}<code>podman stats</code> reports, which is what the kernel charges the container, and which read 2.6 MB
          for a process that held 14.7 MB. A figure that moves fivefold depending on the tool doesn't get printed.
        </p>
        <p class="muted">
          Produced by the benchmark command that ships in the repository, so you can disagree with it on your own
          hardware. The method, the flow file, the exact commands, and the caveats live in the repo's bench docs.
        </p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Why not just keep running Node-RED</span>
        <h2>Four things, and none of them are fixable with configuration.</h2>
      </div>
      <div class="grid grid-2">
        <article class="card reveal">
          <h3>There is no back-pressure.</h3>
          <p>
            Node-RED, by default, puts a <code>setImmediate</code> between every wire hop, and nothing puts a ceiling on that queue. A fast
            source outruns a slow sink, the queue grows, and the pod gets OOM-killed with nothing in the log to explain
            it. Every inbox in Flow is bounded, with a policy per node: block, drop the newest, drop the oldest, or
            raise it to a Catch node and let the flow decide.
          </p>
        </article>
        <article class="card reveal">
          <h3>It is single-threaded.</h3>
          <p>
            One event loop carries the runtime, the editor API, the websocket fan-out, and every node's I/O. One
            CPU-heavy Function node stalls all of it, including the editor you are using to find out why it stalled.
            In Flow, every node instance gets its own goroutine, ordered within a node and parallel across nodes.
          </p>
        </article>
        <article class="card reveal">
          <h3>The Function node's sandbox is not a boundary.</h3>
          <p>
            Node-RED's Function node runs your code in <code>node:vm</code>. That is not our accusation, it is Node's own documentation: <a href="https://nodejs.org/api/vm.html">“The
            <code>node:vm</code> module is not a security mechanism. Do not use it to run untrusted code.”</a>
            Node-RED's own guide says an unsecured editor is only suitable on a trusted network, and anyone who can
            deploy a flow can run commands on the box, which is fine on a Pi in a workshop and not fine on a customer's
            plant floor. It is not hypothetical either:
            <a href="https://nvd.nist.gov/vuln/detail/CVE-2025-41656">CVE-2025-41656</a> is unauthenticated remote
            command execution, rated critical, in Pilz's IndustrialPI 4 firmware, because authentication for the
            Node-RED server on it was not configured by default. That is a CVE in Pilz's product, not in Node-RED, and
            Node-RED's own guide says the editor is not secured by default.
          </p>
        </article>
        <article class="card reveal">
          <h3>Credentials are weakly protected.</h3>
          <p>
            They are encrypted with AES-256-CTR keyed by a raw SHA-256 of your secret. CTR has no MAC, so anyone who can
            write the credentials file on a shared volume can flip chosen plaintext bits, which turns “can write a file”
            into “can change a broker password to one they picked.” And plain SHA-256 is not a key derivation function.
            There is no CVE on either of those, and both are still real.
          </p>
        </article>
      </div>
      <Backpressure />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">What is different, concretely</span>
        <h2>The same idea, rebuilt around what bites people in production.</h2>
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>Area</th><th>Node-RED</th><th>Flow</th></tr></thead>
          <tbody>
            {different.map(([k, a, b]) => <tr><td>{k}</td><td data-label="Node-RED">{a}</td><td data-label="Flow">{b}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="prose muted after">
        Flow is deliberately not identical. Node-RED hands the first recipient on a wire the original message and
        only clones for the rest, so two branches that each think they own their message can quietly corrupt each
        other, and which one breaks depends on the order you wired them. Every recipient in Flow gets its own copy.
        A small message costs 411 to 453 ns to copy. A 1 MiB binary payload would cost 128 to 156 µs per recipient,
        so those travel shared and immutable instead, at 250 to 279 ns, which is exactly where copying would have
        hurt. Every deliberate difference is written down in the compatibility matrix, so none of them is a
        surprise on a live line.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Compatibility</span>
        <h2>{nodes.length} node types, and each one says how close it is.</h2>
        <p class="lede">
          A node that is partially compatible and silent about how is worse than one that is obviously absent,
          because the flow appears to work and quietly does the wrong thing. So a test fails the build if a node
          does not say what is missing.
        </p>
      </div>
      <div class="grid grid-4">
        <div class="card"><div class="mono big">{level('full')}</div><h3 class="t-md">Full</h3><p>Behaves as the Node-RED node of the same type does.</p></div>
        <div class="card"><div class="mono big">{level('partial')}</div><h3 class="t-md">Partial</h3><p>A subset. The notes say exactly which parts are missing.</p></div>
        <div class="card"><div class="mono big">{level('divergent')}</div><h3 class="t-md">Divergent</h3><p>Deliberately different, and the notes say why.</p></div>
        <div class="card"><div class="mono big">{level('flow-only')}</div><h3 class="t-md">Flow only</h3><p>No Node-RED counterpart.</p></div>
      </div>
      <div class="grid grid-2 after">
        <div class="card"><h3 class="t-md">Not supported at all: community nodes</h3><p>They are npm packages that need Node.js. There is no version of this where they work.</p></div>
        <div class="card"><h3 class="t-md">JSONata, checked against the published examples</h3><p>Every property typed <code>jsonata</code> is evaluated by a pure Go JSONata 2.x, and it passes 1,673 of the 1,686 cases in the published test suite. The 13 it misses are listed in the repository.</p></div>
      </div>
      <p class="after"><a class="btn" href="/integrations/#flow-nodes">Browse all {nodes.length} nodes</a></p>
    </div>
  </section>

  <section class="block" id="whats-new">
    <div class="wrap">
      <div class="section-head">
        <span class="label">New in 2.2.0</span>
        <h2>Three things that used to be on the roadmap are in the image.</h2>
        <p class="lede">
          All of it is in <code>ghcr.io/hotloop-io/hotloop-flow:2.2.0</code>. The consequence: a flow that has to talk to
          a PLC, survive a restart or explain itself no longer needs a workaround.
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <div class="cluster head"><h3>Tracing and replay</h3><span class="chip ok">In 2.2.0</span></div>
          <p>Click a debug message and the canvas lights up the path it took, with timing and the payload at every hop, through splits, joins and subflows. Replay a captured message into a draft of the flow and compare the output, or turn a trace into a test. The trace buffer is bounded, and OpenTelemetry export is proven against a real collector.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>Durable state</h3><span class="chip ok">In 2.2.0</span></div>
          <p>Context survives a restart, in SQLite with no cgo. Mark a wire durable and its queue touches the disk only when the node behind it stops answering. A real InfluxDB was killed for ten minutes under steady input and brought back, and the rows came out none missing and none doubled. The consequence: a historian going down for an hour no longer costs you an hour of readings.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>The plant floor</h3><span class="chip ok">In 2.2.0</span></div>
          <p>Modbus TCP read and write, OPC UA read, subscribe and write, S7 and EtherNet/IP read and write, and Sparkplug B as an edge node and as a host. Modbus was tried against pymodbus, OPC UA against Microsoft's OPC PLC, S7 and EtherNet/IP against simulators, and Sparkplug B against a real Mosquitto. None has met a physical PLC.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="block" id="since-2-1">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Already in, from 2.1.0</span>
        <h2>Every deploy is a record, and a flow can be tested before it ships.</h2>
        <p class="lede">
          These shipped in 2.1.0 and are in 2.2.0. The consequence: "who changed the flow on line 3, and put it back"
          is a command, not an archaeology project.
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <div class="cluster head"><h3>Deploy records, diff and rollback</h3><span class="chip ok">Since 2.1.0</span></div>
          <p>Every deploy keeps who, from where, when, the note, the revision it replaced and the flow file byte for byte, with the credentials encrypted as they stood. A diff reads node by node and keeps layout apart from logic, and rollback puts an old record back as a new deploy, flows and credentials together. An optional git mirror commits every deployment under whoever deployed it.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>Flows as code</h3><span class="chip ok">Since 2.1.0</span></div>
          <p><code>hotloop-flow deploy</code> prints the diff against what is running and deploys against the revision it came from, so a race is a red pipeline. A pipeline holds an API token that can read and deploy and nothing else, never an admin password.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>Flow tests and a deploy gate</h3><span class="chip ok">Since 2.1.0</span></div>
          <p>A <code>flows.test.yaml</code> next to <code>flows.json</code> runs on the real runtime and nodes, with Delay, Trigger and Inject on a clock the test moves and the outside world stood in for. Turn on <code>tests.gate</code> and a deploy that fails the suite is refused with the whole report. Rollbacks are not gated.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>Partial deploy</h3><span class="chip ok">Since 2.1.0</span></div>
          <p>A save restarts the nodes that changed. MQTT sessions, listeners and Delay queues on everything else keep running.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>Sign-in that holds up</h3><span class="chip ok">Since 2.1.0</span></div>
          <p>Two-factor sign-in (TOTP) is free, lockouts are on by default, sessions survive a restart, and an audit log records who did what from where.</p>
        </article>
        <article class="card reveal">
          <div class="cluster head"><h3>MQTT 5, TLS and Node-RED's schedules</h3><span class="chip ok">Since 2.1.0</span></div>
          <p>MQTT 5 with properties and the last will, TLS on TCP, HTTP request and MQTT, and Inject on a crontab that fires on the same minute Node-RED would, checked across clock changes in six zones.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Where it stands</span>
        <h2>It runs. It has never run on a plant floor.</h2>
        <p class="lede">
          Verified against real infrastructure, not just its own encoders: MQTT, InfluxDB 2.7 and PostgreSQL 16 in
          Podman. The race detector is clean on every package. Here's what isn't done, roughly in the order it bugs
          me, so you know before you plan around it.
        </p>
      </div>
      <ul class="notdone">
        {notDone.map(([h, b]) => <li><strong>{h}</strong> {b}</li>)}
        <li>
          <strong>It has never run on a real plant floor.</strong> Everything past the deploy line is unproven in the
          field, and it will not be described as production-hardened until a plant has tried to break it.
        </li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card cta reveal">
        <div class="stack">
          <span class="label">Licensing</span>
          <h2>One license, like the rest of HotLoop.</h2>
          <p class="muted">
            Flow is under the HotLoop Business Source License 1.1. Home and lab use is free, and business use is free
            through <a href="https://embernet.ai">EmberNET</a>. Each version converts to GPL-3.0 or later four years after
            its release. The Flow repository is public, so you can read all of it.
          </p>
        </div>
        <a class="btn primary" href="/license/">Read the license</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s7); }
  .page-hero h1 { max-width: 20ch; }
  .page-hero .notice { max-width: 68ch; }
  .after { margin-top: var(--hl-s6); }

  .caveats { margin-top: var(--hl-s7); padding: var(--hl-s6); border: 1px solid var(--hl-border); border-radius: var(--hl-r-card); background: var(--hl-card); display: grid; gap: var(--hl-s3); }
  .caveats ol { padding-left: 1.3em; display: grid; gap: var(--hl-s3); color: var(--hl-ink-soft); }
  .caveats li strong { color: var(--hl-ink); }

  .big { font-size: var(--hl-fs-2xl); font-weight: 800; line-height: 1; margin-bottom: var(--hl-s2); }
  ul.notdone { display: grid; gap: var(--hl-s4); padding-left: 1.2em; max-width: 78ch; color: var(--hl-ink-soft); }
  ul.notdone strong { color: var(--hl-ink); }

  .cta { display: flex; flex-wrap: wrap; gap: var(--hl-s6); justify-content: space-between; align-items: center; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .cta .stack { max-width: 62ch; }
</style>
