---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WordOrder from '../../components/WordOrder.astro';
import { TIERS } from '../../lib/tiers';

export async function getStaticPaths() {
  const all = (await getCollection('protocols')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const p = entry.data;
const tier = TIERS[p.verification];
---

<Base
  title={`${p.name} integration`}
  description={`${p.summary} Verification: ${tier.label}.`}
  ogAlt={`${p.name} on HotLoop Gateway.`}
>
  <section class="page-hero">
    <div class="wrap stack">
      <p class="crumb"><a href="/integrations/">Integrations</a> <span aria-hidden="true">/</span> {p.name}</p>
      <div class="cluster">
        <h1>{p.name}</h1>
        <span class={`chip ${tier.chip}`}>{tier.label}</span>
      </div>
      <p class="lede">{p.summary}</p>

      {p.verification === 'decode' && (
        <div class="notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
          <div>
            <strong>This driver has not been verified against a physical PLC.</strong>
            <p>{p.notVerifiedNote}</p>
          </div>
        </div>
      )}

      {p.verifiedAgainst.length > 0 && (
        <p class="against">
          <strong>Verified against</strong>
          {p.verifiedAgainst.map((v) => <span class="chip none">{v}</span>)}
        </p>
      )}

      {p.vendors.length > 0 && (
        <p class="against">
          <strong>Works with</strong>
          {p.vendors.map((v) => <span class="chip none">{v}</span>)}
        </p>
      )}

      {p.aka.length > 0 && p.verification === 'gateway-mode' && (
        <p class="against">
          {p.aka.map((v) => <span class="chip info">{v}</span>)}
        </p>
      )}
    </div>
  </section>

  <section class="wrap body stack">
    {p.body.map((para) => <p>{para}</p>)}

    {p.addressExamples.length > 0 && (
      <>
        <h2>Addressing</h2>
        <div class="table-wrap">
          <table class="data stack">
            <thead><tr><th>Address</th><th>Means</th></tr></thead>
            <tbody>
              {p.addressExamples.map((a) => (
                <tr><td><code>{a.expr}</code></td><td data-label="Means">{a.means}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {p.trap && (
      <div class="notice info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
        <div><strong>The trap</strong><p>{p.trap}</p></div>
      </div>
    )}

    {entry.id === 'modbus' && <WordOrder />}

    {p.configKeys.length > 0 && (
      <>
        <h2>Configuration</h2>
        <p class="keys">{p.configKeys.map((k) => <code>{k}</code>)}</p>
      </>
    )}

    <nav class="pager" aria-label="Other protocols">
      {prev ? <a href={`/integrations/${prev.id}/`}>&larr; {prev.data.name}</a> : <span></span>}
      {next ? <a href={`/integrations/${next.id}/`}>{next.data.name} &rarr;</a> : <span></span>}
    </nav>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 6vw, var(--hl-s8)) var(--hl-s6); }
  .page-hero h1 { font-size: var(--hl-fs-2xl); }
  .page-hero .notice { max-width: 72ch; }
  .crumb { font-size: var(--hl-fs-sm); color: var(--hl-ink-soft); }
  .against { display: flex; flex-wrap: wrap; gap: var(--hl-s2); align-items: center; font-size: var(--hl-fs-sm); }
  .against strong { margin-right: var(--hl-s2); }
  .against .chip { text-transform: none; letter-spacing: 0; font-size: var(--hl-fs-xs); white-space: normal; }
  .against .chip::before { display: none; }

  .body { max-width: 78ch; padding-bottom: var(--hl-s7); }
  .body > p { color: var(--hl-ink-soft); }
  .body h2 { font-size: var(--hl-fs-xl); margin-top: var(--hl-s7); }
  .keys { display: flex; flex-wrap: wrap; gap: var(--hl-s2); }
  .pager { display: flex; justify-content: space-between; margin-top: var(--hl-s8); padding-top: var(--hl-s5); border-top: 1px solid var(--hl-border); font-weight: 600; }
</style>
