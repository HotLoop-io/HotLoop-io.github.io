---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LoopInstrument from '../components/LoopInstrument.astro';
import CardDetail from '../components/CardDetail.astro';
import { TIERS, TIER_ORDER } from '../lib/tiers';
import { LINES, FAMILY_SENTENCE } from '../lib/family';
import { latestPublished } from '../lib/released';

const protocols = await getCollection('protocols');
const nodes = await getCollection('nodes');
const releases = await getCollection('releases');

const counts = Object.fromEntries(
  TIER_ORDER.map((t) => [
    t,
    // The gateway-mode entry stands for eight protocols, so count what it lists.
    protocols
      .filter((p) => p.data.verification === t)
      .reduce((n, p) => n + (t === 'gateway-mode' ? p.data.aka.length : 1), 0),
  ]),
) as Record<string, number>;

const newest = (product: string) =>
  releases
    .filter((r) => r.data.product === product)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.version.localeCompare(a.data.version, undefined, { numeric: true }))[0];
const gw = newest('core');
const gwOut = releases.filter((r) => r.data.product === 'core' && r.data.published).sort((a, b) => b.data.version.localeCompare(a.data.version, undefined, { numeric: true }))[0];
const fl = newest('flow');
const ca = newest('cascade');
const nativeCount = protocols.filter((p) => p.data.verification !== 'gateway-mode').length;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title="HotLoop: industrial gateway, historian and alarms for PLCs"
  description="Connect PLCs over OPC UA, Modbus, EtherNet/IP, S7 and MQTT, keep the history, and raise ISA-18.2 alarms, on a Raspberry Pi or across every site."
  ogAlt="HotLoop. Automation loops for the real world."
>
  <section class="hero">
    <div class="wrap-wide grid-hero">
      <div class="copy stack">
        <span class="chip ok">Version {gwOut.data.version} is out for all four core products</span>
        <h1>Automation loops for the real world.</h1>
        <p class="lede">
          HotLoop connects to your PLCs and devices, keeps the history, raises the alarms that matter, and moves a
          machine only when someone with the authority arms it. It runs on a Raspberry Pi next to one machine or across
          every site you operate, and it moves up a product without losing your devices, tags or history. It's free for
          home and lab use.
        </p>
        <div class="cluster">
          <a class="btn primary" href="https://docs.hotloop.io/install/">
            Install HotLoop
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="btn" href="/products/">See the lineup</a>
        </div>
      </div>
      <LoopInstrument />
    </div>

    <div class="wrap-wide stats">
      <div class="stat">
        <div class="n mono">{nativeCount}</div>
        <p>Native drivers for OPC UA, Modbus, EtherNet/IP, Siemens S7, MQTT and Sparkplug B, CODESYS and more, each listed with exactly what it was tested against.</p>
      </div>
      <div class="stat">
        <div class="n mono">{nodes.length}</div>
        <p>Flow node types that run your existing Node-RED flows, with every difference documented.</p>
      </div>
      <div class="stat">
        <div class="n mono">45.6<small>MB</small></div>
        <p>The whole Flow container image. It starts in a fraction of a second and runs on a Raspberry Pi 5. The full benchmark and method are on <a href="/flow/#numbers">the Flow page</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The loop</span>
        <h2>Sense, decide, act, and around again.</h2>
        <p class="lede">
          HotLoop runs the loop so your people can walk away from it. It reports a dead sensor as a dead sensor, checks
          every rule when you save it, and refuses any write that is out of range or wasn't armed.
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <h3>Sense</h3>
          <p>Reads real equipment over the protocols it already speaks and records the quality of every reading. A failed read is marked bad, so a dead sensor never trips every low alarm on the unit.</p>
        </article>
        <article class="card reveal">
          <h3>Decide</h3>
          <p>ISA-18.2 alarms, the industrial alarm standard, keep the trip that cleared on its own on the list for the next shift. Rules are checked the moment you save them.</p>
        </article>
        <article class="card reveal">
          <h3>Act</h3>
          <p>
            Every write, from an operator, a rule or an AI agent, passes through one gate with one set of checks, and
            every refusal is logged. {' '}<a href="/gateway/#the-gate">See the write gate</a>.
          </p>
        </article>
      </div>
      <CardDetail>
        <div><h4>Sense</h4><p>HotLoop polls real equipment over the protocols it already speaks and keeps the quality of every reading with the number. A failed read is marked bad, so a dead sensor doesn't trip every low alarm on the unit or send the night shift to check a tank that's fine.</p></div>
        <div><h4>Decide</h4><p>ISA-18.2 alarms, the industrial alarm standard, including the alarm that cleared on its own before anybody saw it. It stays on the list for the next shift. Rules are checked when you save them, so a typo is caught in the editor before it reaches a batch.</p></div>
        <div><h4>Act</h4><p>Every write, from an operator, a rule or an AI agent, passes through one gate. A value out of range is refused rather than quietly changed, and every refusal is logged. <a href="/gateway/#the-gate">See the write gate in action</a>.</p></div>
      </CardDetail>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The products</span>
        <h2>Eight products, from a Pi on a shelf to the whole plant.</h2>
        <p class="lede">{FAMILY_SENTENCE}</p>
      </div>
      <div class="lines">
        {LINES.map((l) => (
          <div class="line">
            <p class="line-head">{latestPublished(releases, l.id) ? <span class="chip ok">{l.label} line, {latestPublished(releases, l.id)!.data.version}</span> : <span class="chip warn">{l.label} line, not released yet</span>}</p>
            <div class="grid grid-4 lineup">
              {l.members.map((m) => (
                <a class="card mini reveal" href={m.href}>
                  <h3>{m.name.replace('HotLoop ', '')}</h3>
                  <p>{m.tagline}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="more"><a class="btn" href="/products/">Compare all eight</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Integrations</span>
        <h2>Every driver shows exactly what it was tested against.</h2>
        <p class="lede">
          Each integration lists the systems it has run against, so your team knows what day one looks like before
          commissioning starts. Protocols HotLoop doesn't speak natively come in through the gateway your site already has.
        </p>
      </div>
      <div class="grid grid-4 tiers">
        {TIER_ORDER.filter((t) => counts[t] > 0).map((t) => (
          <div class="card tier reveal">
            <div class="cluster head">
              <span class={`chip ${TIERS[t].chip}`}>{TIERS[t].label}</span>
              <span class="count mono">{counts[t]}</span>
            </div>
            <p>{TIERS[t].blurb}</p>
          </div>
        ))}
      </div>
      <p class="more"><a class="btn" href="/integrations/">See every integration</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Latest</span>
        <h2>What changed last, and whether you can download it.</h2>
      </div>
      <div class="grid grid-3">
        <a class="card release reveal" href="/releases/flow/">
          <div class="cluster head">
            <h3>Flow {fl.data.version}</h3><span class="chip ok">Published</span>
          </div>
          <p class="date">{fmt(fl.data.date)}</p>
        </a>
        <a class="card release reveal" href="/releases/core/">
          <div class="cluster head">
            <h3>HotLoop core {gw.data.version}</h3><span class={`chip ${gw.data.published ? 'ok' : 'warn'}`}>{gw.data.published ? 'Published' : 'Merged, not published'}</span>
          </div>
          <p class="date">{fmt(gw.data.date)}</p>
        </a>
        <a class="card release reveal" href="/releases/cascade/">
          <div class="cluster head">
            <h3>Cascade {ca.data.version}</h3><span class={`chip ${ca.data.published ? 'ok' : 'warn'}`}>{ca.data.published ? 'Published' : 'Merged, not published'}</span>
          </div>
          <p class="date">{fmt(ca.data.date)}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card licensing reveal">
        <div>
          <span class="label">Licensing</span>
          <h2>Free to use. No license keys.</h2>
          <p class="lede">
            Every HotLoop product is under the HotLoop Source License Agreement 1.0. HotLoop is free to use and source-available, not OSI
open source, and Flow's source is public. Home and lab use is free, and schools, nonprofits and government
            bodies run it free for their own operations. There's no key to type in. For business use, tell us what you
            want to run and we'll set you up with the right license.
          </p>
        </div>
        <div class="cluster">
          <a class="btn primary" href="/license/">What the license means</a>
          <a class="btn" href="mailto:helpdesk@fireballz.ai">Talk to us</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(var(--hl-s7), 6vw, var(--hl-s8)); }
  .grid-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 620px); gap: clamp(var(--hl-s6), 5vw, var(--hl-s8)); align-items: center; }
  /* Side by side, the copy column gets about 250px at 1024 and the h1 broke
     "Automation" in the middle of the word. Stack until there's room. */
  @media (max-width: 1100px) { .grid-hero { grid-template-columns: 1fr; } }
  .copy > .chip { justify-self: start; }
  /* A grid item defaults to min-width:auto, so its widest child sets the column. */
  .grid-hero > * { min-width: 0; }
  .copy h1 { max-width: 14ch; }

  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--hl-s5); margin-top: clamp(var(--hl-s7), 6vw, var(--hl-s8));
    padding-top: var(--hl-s6); border-top: 1px solid var(--hl-border);
  }
  .stat .n { font-size: var(--hl-fs-2xl); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .stat .n small { font-size: 0.45em; margin-left: 0.2em; color: var(--hl-ink-soft); font-weight: 700; }
  .stat p { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); margin-top: var(--hl-s2); max-width: 40ch; }

  .product { display: grid; gap: var(--hl-s4); align-content: start; }
  .product .head { justify-content: space-between; }
  .product .head h3 { margin: 0; }
  .product .what { color: var(--hl-ink); font-size: var(--hl-fs-base); }
  .product .license { padding-top: var(--hl-s3); border-top: 1px solid var(--hl-border); font-size: var(--hl-fs-xs); }
  .product .btn { justify-self: start; }

  .lines { display: grid; gap: var(--hl-s6); }
  .line-head { margin: 0 0 var(--hl-s3); }
  .lineup { margin-top: 0; }
  a.mini { display: grid; gap: var(--hl-s2); align-content: start; text-decoration: none; color: inherit; padding: var(--hl-s5); transition: transform var(--hl-transition-fast), border-color var(--hl-transition-fast); }
  a.mini:hover { transform: translateY(-2px); border-color: var(--hl-orange); }
  .mini .head { justify-content: space-between; }
  .mini h3 { margin: 0; font-size: var(--hl-fs-md); }
  .mini p { font-size: var(--hl-fs-sm); color: var(--hl-ink-soft); }

  .tier .head { justify-content: space-between; margin-bottom: var(--hl-s3); }
  .tier .count { font-size: var(--hl-fs-xl); font-weight: 800; }
  .more { margin-top: var(--hl-s6); }

  a.release { display: block; text-decoration: none; color: inherit; transition: transform var(--hl-transition-fast), box-shadow var(--hl-transition-fast), border-color var(--hl-transition-fast); }
  a.release:hover { transform: translateY(-2px); box-shadow: var(--hl-sh-2); border-color: var(--hl-orange); }
  .release .head { justify-content: space-between; margin-bottom: var(--hl-s1); }
  .release .head h3 { margin: 0; }
  .release .date { font-size: var(--hl-fs-xs); margin-bottom: var(--hl-s3); }

  .licensing { display: flex; flex-wrap: wrap; gap: var(--hl-s6); align-items: center; justify-content: space-between; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .licensing > div { display: grid; gap: var(--hl-s3); max-width: 60ch; }
  .licensing .lede { font-size: var(--hl-fs-md); }
  .licensing > .cluster { display: flex; max-width: none; }
</style>
<style is:global>
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .plate .on-light { display: none; }
    :root:not([data-theme="light"]) .plate .on-dark { display: block; }
    :root:not([data-theme="light"]) .plate .blend { mix-blend-mode: lighten; }
  }
  :root[data-theme="dark"] .plate .on-light { display: none; }
  :root[data-theme="dark"] .plate .on-dark { display: block; }
  :root[data-theme="dark"] .plate .blend { mix-blend-mode: lighten; }
</style>
