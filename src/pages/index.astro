---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LoopInstrument from '../components/LoopInstrument.astro';
import CardDetail from '../components/CardDetail.astro';
import { TIERS, TIER_ORDER } from '../lib/tiers';
import { LINES, FAMILY_SENTENCE } from '../lib/family';

const protocols = await getCollection('protocols');
const nodes = await getCollection('nodes');
const releases = await getCollection('releases');

const counts = Object.fromEntries(
  TIER_ORDER.map((t) => [
    t,
    // The gateway-mode entry stands for eight protocols, so count what it lists.
    protocols
      .filter((p) => p.data.verification === t)
      .reduce((n, p) => n + (t === 'gateway-mode' ? p.data.aka.length : 1), 0),
  ]),
) as Record<string, number>;

const newest = (product: string) =>
  releases
    .filter((r) => r.data.product === product)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.version.localeCompare(a.data.version, undefined, { numeric: true }))[0];
const gw = newest('core');
const gwOut = releases.filter((r) => r.data.product === 'core' && r.data.published).sort((a, b) => b.data.version.localeCompare(a.data.version, undefined, { numeric: true }))[0];
const fl = newest('flow');
const ca = newest('cascade');
const nativeCount = protocols.filter((p) => p.data.verification !== 'gateway-mode').length;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title="HotLoop: automation loops for the real world"
  description="Seven products for the plant floor: IoT, Edge, Gateway, Edge Relay, Flow, Cascade, and HotLoop for CODESYS. Free for home, lab, and business via EmberNet."
  ogAlt="HotLoop. Automation loops for the real world."
>
  <section class="hero">
    <div class="wrap-wide grid-hero">
      <div class="copy stack">
        <span class="chip ok">Version {gwOut.data.version} is out for all four core products</span>
        <h1>Automation loops for the real world.</h1>
        <p class="lede">
          Home automation is a toy right up until the day it matters. Industrial automation works, costs a fortune,
          and comes with a guy who has to drive out to change a setpoint. HotLoop is the thing in the middle that
          should have existed ten years ago: it reads real equipment, keeps the history, raises the alarm, and moves
          the machine, from a Pi on a shelf to a whole plant. It's free for you, and free for your business through
          EmberNet.
        </p>
        <div class="cluster">
          <a class="btn primary" href="/gateway/">
            Meet the Gateway
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="btn" href="/products/">See the lineup</a>
          <a class="btn" href="/flow/">Meet Flow</a>
        </div>
      </div>
      <LoopInstrument />
    </div>

    <div class="wrap-wide stats">
      <div class="stat">
        <div class="n mono">{nativeCount}</div>
        <p>Native protocol drivers in the Gateway, for talking to PLCs and other equipment. No placeholder drivers, and a table that admits which ones have never met a real PLC.</p>
      </div>
      <div class="stat">
        <div class="n mono">{nodes.length}</div>
        <p>Node types in Flow, our Node-RED-compatible wiring tool. Each one says how close it is to Node-RED, and the build fails if one lies about it.</p>
      </div>
      <div class="stat">
        <div class="n mono">44.8<small>MB</small></div>
        <p>The whole Flow 2.3.0 container image (amd64), as Podman reports it. The method and the caveats are on <a href="/flow/#numbers">the Flow page</a>, because a benchmark without caveats is marketing in a lab coat.</p>
      </div>
    </div>
  </section>

  <section class="block running" aria-labelledby="running-at">
    <div class="wrap">
      <div class="section-head">
        <span class="label" id="running-at">Running at</span>
        <p class="lede">HotLoop runs at the plants of Shepherd Boy Farms and DayGlo, both through EmberNet.</p>
      </div>
      <ul class="logos">
        <li><a class="plate" href="https://shepherdboyfarms.com" rel="noopener" aria-label="Shepherd Boy Farms"><img src="/customers/shepherd-boy-farms-logo.png" alt="Shepherd Boy Farms" width="2472" height="1238" loading="lazy" decoding="async" /></a></li>
        <li><a class="plate" href="https://www.dayglo.com" rel="noopener" aria-label="DayGlo"><img src="/customers/dayglo-logo.svg" alt="DayGlo" width="648" height="180" loading="lazy" decoding="async" /></a></li>
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The loop</span>
        <h2>Sense, decide, act, and around again.</h2>
        <p class="lede">
          That's the whole product. A rule you set once and pray over is not a loop. A loop is something you can
          walk away from, because it tells you the truth when it can't see and it refuses to do something stupid when somebody
          tells it to.
        </p>
      </div>
      <div class="grid grid-3">
        <article class="card reveal">
          <h3>Sense</h3>
          <p>Poll real equipment over real protocols and keep each reading's quality. A failed read is bad, never zero, so a dead sensor doesn't trip every low alarm.</p>
        </article>
        <article class="card reveal">
          <h3>Decide</h3>
          <p>ISA-18.2 alarms (the industrial alarm standard), so an alarm that cleared before anybody saw it is still on the list at shift change. Rules compile on save, so a typo dies in the editor.</p>
        </article>
        <article class="card reveal">
          <h3>Act</h3>
          <p>
            Every write, from a person, a rule, or an agent, crosses one gate nothing routes around. Out of range is
            refused, not clamped. {' '}<a href="/gateway/#the-gate">Go try to break it</a>.
          </p>
        </article>
      </div>
      <CardDetail>
        <div><h4>Sense</h4><p>Poll real equipment over real protocols, and keep the quality of every reading, not just the number. A failed read is bad, never zero, so a dead sensor doesn't trip every low alarm on the unit and send the night shift chasing a tank that's fine.</p></div>
        <div><h4>Decide</h4><p>ISA-18.2 alarms (the industrial alarm standard), including the one homegrown systems forget: the alarm that cleared on its own before anybody saw it. It's still on the list at shift change. Rules compile when you save them, so a typo dies in the editor, not at 3am halfway through a batch.</p></div>
        <div><h4>Act</h4><p>Every write, from a person, a rule, or an agent, crosses one gate that nothing routes around. Out of range is refused, not clamped, and the refusal gets written down. Want to watch it say no? <a href="/gateway/#the-gate">Go try to break it</a>.</p></div>
      </CardDetail>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">The products</span>
        <h2>Seven products, from a Pi on a shelf to the whole plant.</h2>
        <p class="lede">{FAMILY_SENTENCE}</p>
      </div>
      <div class="lines">
        {LINES.map((l) => (
          <div class="line">
            <p class="line-head">{l.released ? <span class="chip ok">{l.label} line, {l.id === 'flow' ? fl.data.version : l.version}</span> : <span class="chip warn">{l.label} line, not released yet</span>}</p>
            <div class="grid grid-4 lineup">
              {l.members.map((m) => (
                <a class="card mini reveal" href={m.href}>
                  <h3>{m.name.replace('HotLoop ', '')}</h3>
                  <p>{m.tagline}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="more"><a class="btn" href="/products/">Compare all seven</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">What we refuse to fake</span>
        <h2>Every integration says how far it has actually been proven.</h2>
        <p class="lede">
          Most integration pages are a wall of logos. Ours has four tiers, and the top one is empty on purpose,
          because nothing has earned it yet. You'd rather know that now than at commissioning.
        </p>
      </div>
      <div class="grid grid-4 tiers">
        {TIER_ORDER.map((t) => (
          <div class="card tier reveal">
            <div class="cluster head">
              <span class={`chip ${TIERS[t].chip}`}>{TIERS[t].label}</span>
              <span class="count mono">{counts[t]}</span>
            </div>
            <p>{TIERS[t].blurb}</p>
          </div>
        ))}
      </div>
      <p class="more"><a class="btn" href="/integrations/">See every integration</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">Latest</span>
        <h2>What changed last, and whether you can download it.</h2>
      </div>
      <div class="grid grid-3">
        <a class="card release reveal" href="/releases/flow/">
          <div class="cluster head">
            <h3>Flow {fl.data.version}</h3><span class="chip ok">Published</span>
          </div>
          <p class="date">{fmt(fl.data.date)}</p>
        </a>
        <a class="card release reveal" href="/releases/core/">
          <div class="cluster head">
            <h3>HotLoop core {gw.data.version}</h3><span class={`chip ${gw.data.published ? 'ok' : 'warn'}`}>{gw.data.published ? 'Published' : 'Merged, not published'}</span>
          </div>
          <p class="date">{fmt(gw.data.date)}</p>
        </a>
        <a class="card release reveal" href="/releases/cascade/">
          <div class="cluster head">
            <h3>Cascade {ca.data.version}</h3><span class={`chip ${ca.data.published ? 'ok' : 'warn'}`}>{ca.data.published ? 'Published' : 'Merged, not published'}</span>
          </div>
          <p class="date">{fmt(ca.data.date)}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card licensing reveal">
        <div>
          <span class="label">Licensing</span>
          <h2>One license, no keys.</h2>
          <p class="lede">
            Every HotLoop product is under the HotLoop Business Source License 1.1. Home and lab use is free. A
            business signs up for <a href="https://embernet.ai">EmberNet</a>, free, and runs HotLoop there, free.
            Each version turns into GPL-3.0 or later four years after it ships. There's no key to type in and nothing waiting
            behind a paywall. Want somebody else to own the rollout, SLAs and warranty included? That's our Official
            Systems Integrator, {' '}<a href="https://fireballz.ai">Fireball Industries</a>.
          </p>
        </div>
        <a class="btn primary" href="/license/">What the license means</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Customer logos are the companies' own files, never recolored. Both sit on the same
     dark plate in either theme, because DayGlo's mark has a white wordmark. Sized by height only. */
  .running .section-head { margin-bottom: var(--hl-s5); }
  .logos { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--hl-s4); align-items: stretch; }
  .plate { display: flex; align-items: center; justify-content: center; padding: var(--hl-s4) var(--hl-s6); background: #14120F; border: 1px solid var(--hl-border); border-radius: var(--hl-r-card); transition: border-color var(--hl-transition-fast); }
  .plate:hover { border-color: var(--hl-orange); }
  .plate img { height: 72px; width: auto; display: block; }
  .hero { padding-top: clamp(var(--hl-s7), 6vw, var(--hl-s8)); }
  .grid-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 620px); gap: clamp(var(--hl-s6), 5vw, var(--hl-s8)); align-items: center; }
  /* Side by side, the copy column gets about 250px at 1024 and the h1 broke
     "Automation" in the middle of the word. Stack until there's room. */
  @media (max-width: 1100px) { .grid-hero { grid-template-columns: 1fr; } }
  .copy > .chip { justify-self: start; }
  /* A grid item defaults to min-width:auto, so its widest child sets the column. */
  .grid-hero > * { min-width: 0; }
  .copy h1 { max-width: 14ch; }

  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--hl-s5); margin-top: clamp(var(--hl-s7), 6vw, var(--hl-s8));
    padding-top: var(--hl-s6); border-top: 1px solid var(--hl-border);
  }
  .stat .n { font-size: var(--hl-fs-2xl); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .stat .n small { font-size: 0.45em; margin-left: 0.2em; color: var(--hl-ink-soft); font-weight: 700; }
  .stat p { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); margin-top: var(--hl-s2); max-width: 40ch; }

  .product { display: grid; gap: var(--hl-s4); align-content: start; }
  .product .head { justify-content: space-between; }
  .product .head h3 { margin: 0; }
  .product .what { color: var(--hl-ink); font-size: var(--hl-fs-base); }
  .product .license { padding-top: var(--hl-s3); border-top: 1px solid var(--hl-border); font-size: var(--hl-fs-xs); }
  .product .btn { justify-self: start; }

  .lines { display: grid; gap: var(--hl-s6); }
  .line-head { margin: 0 0 var(--hl-s3); }
  .lineup { margin-top: 0; }
  a.mini { display: grid; gap: var(--hl-s2); align-content: start; text-decoration: none; color: inherit; padding: var(--hl-s5); transition: transform var(--hl-transition-fast), border-color var(--hl-transition-fast); }
  a.mini:hover { transform: translateY(-2px); border-color: var(--hl-orange); }
  .mini .head { justify-content: space-between; }
  .mini h3 { margin: 0; font-size: var(--hl-fs-md); }
  .mini p { font-size: var(--hl-fs-sm); color: var(--hl-ink-soft); }

  .tier .head { justify-content: space-between; margin-bottom: var(--hl-s3); }
  .tier .count { font-size: var(--hl-fs-xl); font-weight: 800; }
  .more { margin-top: var(--hl-s6); }

  a.release { display: block; text-decoration: none; color: inherit; transition: transform var(--hl-transition-fast), box-shadow var(--hl-transition-fast), border-color var(--hl-transition-fast); }
  a.release:hover { transform: translateY(-2px); box-shadow: var(--hl-sh-2); border-color: var(--hl-orange); }
  .release .head { justify-content: space-between; margin-bottom: var(--hl-s1); }
  .release .head h3 { margin: 0; }
  .release .date { font-size: var(--hl-fs-xs); margin-bottom: var(--hl-s3); }

  .licensing { display: flex; flex-wrap: wrap; gap: var(--hl-s6); align-items: center; justify-content: space-between; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .licensing > div { display: grid; gap: var(--hl-s3); max-width: 60ch; }
  .licensing .lede { font-size: var(--hl-fs-md); }
</style>
