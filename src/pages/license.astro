---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const licenseText = await getEntry('legal', 'license');
if (!licenseText) throw new Error('src/legal/LICENSE.md is missing, so /license has no license to render.');
const { Content: LicenseText } = await render(licenseText);

const situations: [string, boolean][] = [
  ['Automating your own house', true],
  ['A hobby project you are building for fun', true],
  ['A home lab, however large and however much of your weekend it eats', true],
  ['A class project or a student lab', true],
  ['An accredited school or university running it for its own operations', true],
  ['A nonprofit, or a city or other government body, running it for its own operations', true],
  ['Running it inside a company, internal only, no customers touching it', false],
  ['Deploying it as part of a product or service you sell', false],
  ['A landlord automating a rental property they operate as a business', false],
  ['A contractor installing and managing it for paying clients', false],
];

const products: [string, string][] = [
  ['HotLoop IoT', '/iot/'],
  ['HotLoop Edge', '/edge/'],
  ['HotLoop Gateway', '/gateway/'],
  ['HotLoop Edge Relay', '/edge-relay/'],
  ['HotLoop Flow', '/flow/'],
  ['HotLoop Cascade', '/cascade/'],
];
---

<Base
  title="HotLoop license: one license for every product"
  description="Every HotLoop product is under the Business Source License 1.1. Free for home, lab, schools, nonprofits, and government, and for business through EmberNet."
  ogAlt="HotLoop licensing, in plain language."
>
  <section class="page-hero">
    <div class="wrap stack">
      <span class="label">License</span>
      <h1>One license. Six products. No keys.</h1>
      <p class="lede">
        Every HotLoop product is under HotLoop's own Business Source License 1.1, with HotLoop LLC as the licensor.
        Home and lab use is free. Business use is free when you run it through EmberNet. That's the whole deal, and
        it's the one we should have shipped from the start. Know which side you're on before you build a plant on a
        guess.
      </p>
    </div>
  </section>

  <section class="wrap body stack">
    <div class="table-wrap">
      <table class="data stack">
        <thead><tr><th>Who</th><th>Cost</th><th>How to get it</th></tr></thead>
        <tbody>
          <tr>
            <td>Home and lab use</td>
            <td data-label="Cost"><span class="chip ok">Free</span></td>
            <td data-label="How to get it">Self-host directly, no agreement and no key</td>
          </tr>
          <tr>
            <td>Accredited schools, nonprofits and government bodies</td>
            <td data-label="Cost"><span class="chip ok">Free</span></td>
            <td data-label="How to get it">Self-host directly for your own operations, no agreement and no key</td>
          </tr>
          <tr>
            <td>Business use</td>
            <td data-label="Cost"><span class="chip info">Free, through EmberNet</span></td>
            <td data-label="How to get it">Run it through <a href="https://embernet.ai">EmberNet</a>, HotLoop's free business-use channel</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>It covers the whole lineup</h2>
    <p>
      The same license applies to every product, so there is no second set of terms to read when you add one.
    </p>
    <ul class="products">
      {products.map(([n, h]) => <li><a href={h}>{n}</a></li>)}
    </ul>

    <h2>What the Business Source License means here</h2>
    <p>
      There are no license keys and nothing unlocks at runtime. Which product you run is which image you pulled. It
      is source-available, not OSI-approved open source, and we won't pretend otherwise.
    </p>
    <p>
      Each version converts to GPL-3.0 or later four years after it is released. A release from today is a GPL-3.0 release in
      2030, so what you build on HotLoop doesn't depend on HotLoop staying in business.
    </p>

    <h2>A few real situations</h2>
    <p>“Business use” gets fuzzy fast once somebody starts talking themselves into it, so here are the usual ones.</p>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Situation</th><th>Cost</th></tr></thead>
        <tbody>
          {situations.map(([s, free]) => (
            <tr><td>{s}</td><td class="cost">{free ? <span class="chip ok">Free</span> : <span class="chip info">Through EmberNet</span>}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">
      Not sure which side you're on? Ask before you build a whole setup on a bad assumption. Email
      {' '}<a href="mailto:support@hotloop.io">support@hotloop.io</a>, or go straight to EmberNet if it smells like a
      business case. Either way the answer costs you nothing.
    </p>

    <h2 id="business">Using HotLoop in a business</h2>
    <p>Two ways in, and you can take both.</p>
    <p>
      <strong>Do it yourself on EmberNet.</strong> EmberNet is the free channel business use of HotLoop goes through.
      Sign up for <a href="https://embernet.ai">EmberNet</a> and run HotLoop there at no cost.
    </p>
    <p>
      <strong>Have it rolled out for you.</strong> <a href="https://fireballz.ai">Fireball Industries</a> is our
      Official Systems Integrator. If you want a company to design, install and support a rollout, that is who to
      talk to.
    </p>
    <p>
      The <a href="https://docs.hotloop.io/business/">docs</a> cover the business route too, in case that is where
      you landed first.
    </p>

    <p class="muted">
      The summary above is plain language and the license text below wins every argument, including this one.
      Questions go to <a href="mailto:support@hotloop.io">support@hotloop.io</a>.
    </p>

    <h2 id="text">The license text</h2>
    <p class="muted">
      This is HotLoop-io/HotLoop-io <a href="https://github.com/HotLoop-io/HotLoop-io/blob/main/LICENSE.md">LICENSE.md</a>,
      word for word. The site's build fails if this copy and that one ever differ.
    </p>
    <div class="legal"><LicenseText /></div>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s6); }
  .body { max-width: 860px; padding-bottom: var(--hl-s8); }
  .body h2 { font-size: var(--hl-fs-xl); margin-top: var(--hl-s7); }
  td.cost { width: 1%; white-space: nowrap; }
  @media (max-width: 480px) { td.cost { white-space: normal; } }
  .legal { padding: var(--hl-s5); border: 1px solid var(--hl-border); border-radius: var(--hl-r-card); background: var(--hl-card); }
  .legal :global(p) { margin-block: var(--hl-s3); overflow-wrap: anywhere; }
  ul.products { display: flex; flex-wrap: wrap; gap: var(--hl-s2) var(--hl-s5); list-style: none; padding: 0; }
</style>
