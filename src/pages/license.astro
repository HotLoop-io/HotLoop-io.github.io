---
import Base from '../layouts/Base.astro';

// The plain-language license page. The full agreement lives in the HotLoop-io/HotLoop-io
// repository and is linked from here, so this page carries no legal text of its own.
const agreement = 'https://github.com/HotLoop-io/HotLoop-io/blob/main/LICENSE.md';

const situations: [string, boolean][] = [
  ['Automating your own house', true],
  ['A hobby project you are building for fun', true],
  ['A home lab, however large', true],
  ['A class project or a student lab', true],
  ['An accredited school or university running it for its own operations', true],
  ['A nonprofit, or a city or other government body, running it for its own operations', true],
  ['Running it inside a company to support its operations', false],
  ['Deploying it as part of a product or service you sell', false],
  ['A contractor installing and managing it for paying clients', false],
];

const products: [string, string][] = [
  ['HotLoop IoT', '/iot/'],
  ['HotLoop Edge', '/edge/'],
  ['HotLoop Gateway', '/gateway/'],
  ['HotLoop Edge Relay', '/edge-relay/'],
  ['HotLoop Flow', '/flow/'],
  ['HotLoop Cascade', '/cascade/'],
  ['HotLoop for CODESYS', '/codesys/'],
  ['HotLoop Transmitter', '/transmitter/'],
];
---

<Base
  title="HotLoop license: what you can do with HotLoop"
  description="One source license for every HotLoop product. Free for home, lab, schools, nonprofits and government. Every version becomes AGPL-3.0 after four years."
  ogAlt="HotLoop licensing, in plain language."
>
  <section class="page-hero">
    <div class="wrap stack">
      <span class="label">License</span>
      <h1>One license. Every HotLoop product.</h1>
      <p class="lede">
        Every HotLoop product ships under the HotLoop Source License Agreement 1.0. You get the source, you can change it,
        and you can run it free at home, in the lab, at school, at a nonprofit or in government. Every version becomes
        AGPL-3.0 or later four years after it is released.
      </p>
    </div>
  </section>

  <section class="wrap body stack">
    <div class="table-wrap">
      <table class="data stack">
        <thead><tr><th>Who</th><th>Cost</th><th>How to get it</th></tr></thead>
        <tbody>
          <tr>
            <td>Home and lab use</td>
            <td data-label="Cost"><span class="chip ok">Free</span></td>
            <td data-label="How to get it">Self-host directly, no agreement and no key</td>
          </tr>
          <tr>
            <td>Accredited schools, nonprofits and government bodies</td>
            <td data-label="Cost"><span class="chip ok">Free</span></td>
            <td data-label="How to get it">Self-host directly for your own operations, no agreement and no key</td>
          </tr>
          <tr>
            <td>Business use</td>
            <td data-label="Cost"><span class="chip info">No charge beyond your EmberNet plan</span></td>
            <td data-label="How to get it">Run it through <a href="https://embernet.ai">EmberNet</a>, HotLoop's Gold Licensee. A free Pilot covers evaluation and pre-production, and a production plant runs on Starter or above, as the <a href="https://embernet.ai/pricing.html">EmberNet pricing page</a> sets out</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>What you can do</h2>
    <ul class="can">
      <li><strong>Read, copy, change and share it.</strong> You can copy, modify and redistribute HotLoop and build your own work on it, and use it for anything that is not production use.</li>
      <li><strong>Run it at home and in the lab.</strong> Personal, hobby, educational, evaluation, development and testing use is free.</li>
      <li><strong>Run it at a school, nonprofit or government body.</strong> Accredited schools, nonprofits and government bodies can run HotLoop for their own operations, and can have a contractor install and operate it for them on equipment they own or control.</li>
      <li><strong>Build Spark SDK and Transmitter into what you make.</strong> Put the Spark SDK in your own firmware and the HotLoop Transmitter library in your own PLC projects, and sell the compiled result to your customers.</li>
    </ul>

    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Situation</th><th>Cost</th></tr></thead>
        <tbody>
          {situations.map(([s, free]) => (
            <tr><td>{s}</td><td class="cost">{free ? <span class="chip ok">Free</span> : <span class="chip info">Talk to us</span>}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="business">Using HotLoop in a business</h2>
    <p>
      Running HotLoop to support a company's operations, building it into something you sell, or hosting it for your
      customers is business use. Email EmberNet, HotLoop's Gold Licensee, at <a href="mailto:info@hotloop.ai">info@hotloop.ai</a>, tell us what you want
      to run and where, and we'll set you up with the right license for it.
    </p>

    <h2>Every version becomes AGPL</h2>
    <p>
      Four years after a version of a HotLoop product is first released, that version is also available under the GNU
      Affero General Public License, version 3 or later. From then on, anyone can use that version under either license.
    </p>

    <h2>It covers the whole lineup</h2>
    <p>
      One agreement covers every product, so there is one set of terms to read. A version released under an earlier
      license stays under that license.
    </p>
    <ul class="products">
      {products.map(([n, h]) => <li><a href={h}>{n}</a></li>)}
    </ul>

    <h2 id="text">The full agreement</h2>
    <p>
      This page is the short version. The <a href={agreement}>HotLoop Source License Agreement 1.0</a> is the full text,
      and where the two differ, the agreement governs. Questions go to EmberNet, HotLoop's Gold Licensee, at
      {' '}<a href="mailto:info@hotloop.ai">info@hotloop.ai</a>.
    </p>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s6); }
  .body { max-width: 860px; padding-bottom: var(--hl-s8); }
  .body h2 { font-size: var(--hl-fs-xl); margin-top: var(--hl-s7); }
  td.cost { width: 1%; white-space: nowrap; }
  @media (max-width: 480px) { td.cost { white-space: normal; } }
  ul.can { display: grid; gap: var(--hl-s3); padding-left: 1.2em; }
  ul.products { display: flex; flex-wrap: wrap; gap: var(--hl-s2) var(--hl-s5); list-style: none; padding: 0; }
</style>
