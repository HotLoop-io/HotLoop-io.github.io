---
import Releases from '../../views/Releases.astro';

// One file serves /releases/, /releases/core/, /releases/flow/, /releases/cascade/, /releases/codesys/ and /releases/transmitter/.
export function getStaticPaths() {
  return [
    { params: { product: undefined }, props: { filter: 'all' } },
    { params: { product: 'core' }, props: { filter: 'core' } },
    { params: { product: 'flow' }, props: { filter: 'flow' } },
    { params: { product: 'cascade' }, props: { filter: 'cascade' } },
    { params: { product: 'codesys' }, props: { filter: 'codesys' } },
    { params: { product: 'transmitter' }, props: { filter: 'transmitter' } },
  ];
}

const { filter } = Astro.props;
---

<Releases filter={filter} />
