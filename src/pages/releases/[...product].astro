---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// One file serves /releases/, /releases/core/, /releases/flow/ and /releases/cascade/.
export function getStaticPaths() {
  return [
    { params: { product: undefined }, props: { filter: 'all' } },
    { params: { product: 'core' }, props: { filter: 'core' } },
    { params: { product: 'flow' }, props: { filter: 'flow' } },
    { params: { product: 'cascade' }, props: { filter: 'cascade' } },
  ];
}

const { filter } = Astro.props;
const all = (await getCollection('releases')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.version.localeCompare(a.data.version, undefined, { numeric: true }));
const releases = filter === 'all' ? all : all.filter((r) => r.data.product === filter);

const NAME = { core: 'HotLoop core', flow: 'Flow', cascade: 'Cascade' } as const;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const unpublished = all.filter((r) => r.data.product === 'core' && !r.data.published);
const coreLatest = all.find((r) => r.data.product === 'core' && r.data.published);

// An unpublished version older than a published one was never a release of its
// own, but its work is in that release, and the chip says which one.
const older = (a: string, b: string) => a.localeCompare(b, undefined, { numeric: true }) < 0;
const chipFor = (r: (typeof all)[number]) => {
  if (r.data.published) return { cls: 'ok', label: 'Published' };
  // `all` is newest first, so the last match is the first release it went out in.
  const first = all.filter((p) => p.data.product === r.data.product && p.data.published && older(r.data.version, p.data.version)).at(-1);
  return first ? { cls: 'info', label: `Not tagged, shipped in ${first.data.version}` } : { cls: 'warn', label: 'Merged, not published' };
};
// The release that finally shipped the untagged run. Not simply the newest
// release: once 4.17.0 came out, "until 4.17.0" would have been a lie about
// what 4.16.0 did.
const shippedIn = unpublished[0] && all.filter((p) => p.data.product === 'core' && p.data.published && older(unpublished[0].data.version, p.data.version)).at(-1);
const title = filter === 'all' ? 'Release notes' : `${NAME[filter as 'core' | 'flow' | 'cascade']} release notes`;

// Three pages, three different titles and descriptions. Identical ones make search
// engines pick one of them arbitrarily and ignore the rest.
const coreFirst = all.filter((r) => r.data.product === 'core').at(-1)?.data.version;
const seo = {
  all: {
    title: 'HotLoop release notes: HotLoop core, Flow and Cascade',
    description:
      'What changed in HotLoop core (IoT, Edge, Gateway and Edge Relay), Flow and Cascade, version by version, including which versions have actually been published.',
  },
  core: {
    title: 'HotLoop core release notes and version history',
    description: `Every HotLoop core version from ${coreFirst} onward, shared by IoT, Edge, Gateway and Edge Relay, with what changed and whether it was published.`,
  },
  flow: {
    title: 'HotLoop Flow release notes and version history',
    description:
      'HotLoop Flow release notes, starting with version 0.1.0, which is public today under its original name.',
  },
  cascade: {
    title: 'HotLoop Cascade release notes and version history',
    description:
      'HotLoop Cascade release notes, from 0.1.1, the first release, to 0.1.2, and why the 0.1.0 tag never published anything.',
  },
}[filter as 'all' | 'core' | 'flow' | 'cascade'];
---

<Base
  title={seo.title}
  description={seo.description}
  ogAlt="HotLoop release notes."
>
  <section class="page-hero">
    <div class="wrap stack">
      <span class="label">Releases</span>
      <h1>{title}</h1>
      <nav class="cluster tabs" aria-label="Filter by product">
        <a class="pill" href="/releases/" aria-current={filter === 'all' ? 'page' : undefined}>All</a>
        <a class="pill" href="/releases/core/" aria-current={filter === 'core' ? 'page' : undefined}>HotLoop core</a>
        <a class="pill" href="/releases/flow/" aria-current={filter === 'flow' ? 'page' : undefined}>Flow</a>
        <a class="pill" href="/releases/cascade/" aria-current={filter === 'cascade' ? 'page' : undefined}>Cascade</a>
        <a class="pill rss" href="/releases/rss.xml">RSS</a>
      </nav>

      {(filter === 'all' || filter === 'core') && unpublished.length > 0 && coreLatest && shippedIn && (
        <div class="notice info">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
          <div>
            <strong>HotLoop core {coreLatest.data.version} is out. Versions {unpublished[unpublished.length - 1].data.version} through {unpublished[0].data.version} were never published on their own.</strong>
            <p>
              They were merged one at a time and never tagged, so there was nothing to download until
              {' '}{shippedIn.data.version}, which shipped every one of them at once. Each entry is still marked the way
              it happened, so nobody has to guess which versions were real releases.
            </p>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="wrap feed">
    {releases.map((r) => {
      return (
        <article class="entry" id={`${r.data.product}-${r.data.version}`}>
          <header>
            <div class="cluster">
              <h2><a href={`#${r.data.product}-${r.data.version}`}>{NAME[r.data.product]} {r.data.version}</a></h2>
              <span class={`chip ${chipFor(r).cls}`}>{chipFor(r).label}</span>
            </div>
            <time class="mono" datetime={r.data.date.toISOString().slice(0, 10)}>{fmt(r.data.date)}</time>
          </header>
          <p class="summary">{r.data.summary}</p>
          <ul>{r.data.highlights.map((h) => <li>{h}</li>)}</ul>
          {r.data.breaking.length > 0 && (
            <div class="notice">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
              <div><strong>Breaking</strong><ul>{r.data.breaking.map((b) => <li>{b}</li>)}</ul></div>
            </div>
          )}
          {r.body && r.body.trim() && <p class="note">{r.body.trim()}</p>}
        </article>
      );
    })}
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 6vw, var(--hl-s8)) var(--hl-s6); }
  .page-hero .notice { max-width: 72ch; }
  .pill { padding: 0.45em 1.1em; border-radius: var(--hl-r-pill); border: 1px solid var(--hl-border); background: var(--hl-card); color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); font-weight: 600; text-decoration: none; }
  .pill:hover { color: var(--hl-ink); border-color: var(--hl-line-strong); }
  .pill[aria-current='page'] { background: var(--hl-ink); border-color: var(--hl-ink); color: var(--hl-bg); }

  .feed { max-width: 820px; padding-block: var(--hl-s6) var(--hl-s8); display: grid; gap: 0; }
  /* Image names and URLs in the notes are one unbreakable word each, and at
     320px one of them was enough to push the whole page sideways. */
  .entry { padding-block: var(--hl-s7); border-top: 1px solid var(--hl-border); display: grid; gap: var(--hl-s3); overflow-wrap: anywhere; }
  .entry > * { min-width: 0; }
  .entry:first-child { border-top: 0; }
  .entry header { display: grid; gap: var(--hl-s1); }
  .entry h2 { font-size: var(--hl-fs-xl); }
  .entry h2 a { color: var(--hl-ink); text-decoration: none; }
  .entry h2 a:hover { color: var(--hl-link); }
  time { font-size: var(--hl-fs-xs); color: var(--hl-ink-soft); }
  .summary { font-size: var(--hl-fs-md); font-weight: 600; }
  .entry > ul { padding-left: 1.2em; display: grid; gap: var(--hl-s2); color: var(--hl-ink-soft); }
  .entry .notice ul { padding-left: 1.2em; display: grid; gap: var(--hl-s1); color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); }
  .note { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); padding-left: var(--hl-s4); border-left: 2px solid var(--hl-border); }
</style>
