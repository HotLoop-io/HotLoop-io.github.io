---
import Base from '../layouts/Base.astro';
import AlsoSee from '../components/AlsoSee.astro';
import JsonLd from '../components/JsonLd.astro';
import LeadCard from '../components/LeadCard.astro';
import FamilyLine from '../components/FamilyLine.astro';
import { getCollection } from 'astro:content';
import { TRANSMITTER } from '../lib/products';
import { latestPublished } from '../lib/released';
import { forPage } from '../i18n/page';

const { t, rich, to } = forPage(Astro.url.pathname);
const R = !!latestPublished(await getCollection('releases'), 'transmitter');
const base = `${TRANSMITTER.downloads}${TRANSMITTER.version}/`;
const libFile = `HotLoopTransmitter-${TRANSMITTER.version}.library`;
const v = TRANSMITTER.version;

const snippet = `PROGRAM PLC_PRG
VAR
    pub : HLTX.FB_HLTX_Publisher;
    bInit : BOOL;
END_VAR

IF NOT bInit THEN
    bInit := TRUE;
    pub.sDestination := '239.0.0.22';
    pub.uiPublisherId := 1;
    pub.tPublishingInterval := T#100MS;
    pub.AddReal(ADR(GVL.rTemperature));
    pub.AddBool(ADR(GVL.bRunning));
END_IF
pub.bEnable := TRUE;
pub();`;

// The story reads top to bottom: the problem, what it does, where it fits, how it installs, what was proven,
// and then the reference material (what is in it, what it refuses, what comes after).
const pair = (p: string, n: number, a: string, b: string): [string, string][] =>
  Array.from({ length: n }, (_, i) => [t(`tx.${p}${i + 1}${a}`), t(`tx.${p}${i + 1}${b}`)] as [string, string]);
const proof = pair('pr', 8, 'k', 'v');
const wontDo = pair('w', 4, 'h', 'b');
const built = pair('b', 7, 'h', 'b');
const planned = pair('pl', 2, 'k', 'v');
---

<Base
  title={t('tx.title')}
  description={R ? t('tx.desc') : t('tx.descNR')}
  ogAlt={t('tx.ogAlt')}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop Transmitter',
      url: 'https://hotloop.io/transmitter/',
      description: 'A CODESYS library, written in Structured Text, that publishes PLC values as OPC UA PubSub over UDP.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'CODESYS runtimes',
      license: 'https://hotloop.io/license/',
      ...(R ? { softwareVersion: v, downloadUrl: `${base}${libFile}` } : {}),
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster">
        <span class="label">HotLoop Transmitter</span>
        {R ? <span class="chip ok">{t('tx.rel', { version: v })}</span> : <span class="chip warn">{t('tx.notRel')}</span>}
      </div>
      <h1>{t('tx.h1')}</h1>
      <p class="lede">{t('tx.lede')}</p>
      {!R && (
        <div class="notice info">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
          <div>
            <strong>{t('tx.nTitle')}</strong>
            <p>{t('tx.nBody')}</p>
          </div>
        </div>
      )}
      <div class="cluster">
        <a class="btn primary" href="#install">{t('tx.btnInstall')}</a>
        <a class="btn" href={to('/releases/transmitter/')}>{t('fl.notes')}</a>
        <a class="btn" href="https://docs.hotloop.io/transmitter/overview/">{t('fl.docs')}</a>
        <a class="btn" href={to('/products/')}>{t('tx.btnLineup')}</a>
      </div>
      <FamilyLine id="transmitter" />
    </div>
  </section>

  <section class="block" id="use">
    <div class="wrap grid grid-2 split">
      <div class="stack">
        <span class="label">{t('tx.l1')}</span>
        <h2>{t('tx.h2a')}</h2>
        <p class="muted">{t('tx.p1')}</p>
        <p class="muted">{t('tx.p2')}</p>
      </div>
      <div class="stack">
        <pre dir="ltr"><code>{snippet}</code></pre>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap grid grid-2 split">
      <div class="stack">
        <span class="label">{t('tx.l2')}</span>
        <h2>{t('tx.h2b')}</h2>
        <p class="muted">{t('tx.p3')}</p>
      </div>
      <div class="stack">
        <span class="label">{t('tx.l3')}</span>
        <h2>{t('tx.h2c')}</h2>
        <p class="muted" set:html={rich('tx.p4')} />
      </div>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('tx.l4')}</span>
        <h2>{t('tx.h2d')}</h2>
        <p class="lede">
          {R ? t('tx.p5', { version: v }) : t('tx.p5nr')}
          {' '}{t('tx.p6')}
        </p>
      </div>
      {R && (
        <div class="cluster">
          <a class="btn primary" href={`${base}${libFile}`}>{t('tx.dl', { file: libFile })}</a>
          <a class="btn" href={`${base}HotLoopTransmitter-${v}.package`}>{t('tx.dlPkg')}</a>
          <a class="btn" href={`${base}HotLoopTransmitter-${v}.compiled-library`}>{t('tx.dlCompiled')}</a>
          <a class="btn" href={`${base}SHA256SUMS`}>SHA256SUMS</a>
        </div>
      )}
      <ol class="steps">
        <li set:html={t('tx.s1', { file: libFile })} />
        <li>{t('tx.s2')}</li>
        <li set:html={t('tx.s3')} />
        <li>{t('tx.s4')}</li>
      </ol>
      <p class="muted note" set:html={rich('tx.note')} />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('tx.l5')}</span>
        <h2>{t('tx.h2e')}</h2>
        <p class="lede" set:html={rich('tx.p7')} />
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>{t('tx.thCheck')}</th><th>{t('tx.thWhat')}</th></tr></thead>
          <tbody>
            {proof.map(([k, val]) => <tr><td class="mono">{k}</td><td data-label={t('tx.thWhat')}>{val}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('tx.l6')}</span>
        <h2>{R ? t('tx.h2f', { version: v }) : t('tx.h2fnr')}</h2>
      </div>
      <div class="grid grid-3">
        {built.map(([h, b]) => <LeadCard h={h} b={b} />)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('tx.l7')}</span>
        <h2>{t('tx.h2g')}</h2>
      </div>
      <div class="grid grid-2">
        {wontDo.map(([h, b]) => <LeadCard h={h} b={b} />)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('tx.l8')}</span>
        <h2>{t('tx.h2h')}</h2>
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>{t('tx.thWhen')}</th><th>{t('tx.thWhat')}</th></tr></thead>
          <tbody>
            {planned.map(([k, w]) => <tr><td class="mono">{k}</td><td data-label={t('tx.thWhat')}>{w}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card cta reveal">
        <div class="stack">
          <span class="label">{t('tx.l9')}</span>
          <h2>{t('tx.h2i')}</h2>
          <p class="muted">{t('tx.p8')}</p>
        </div>
        <a class="btn primary" href={to('/license/')}>{t('iot.licBtn')}</a>
      </div>
    </div>
  </section>
  <AlsoSee heading="Moving from CODESYS WebVisu to a HotLoop screen?" items={[{ label: "A CODESYS HMI outside the runtime", href: "/codesys-webvisu-alternative/" }, { label: "An OPC UA gateway for the rest of the plant", href: "/opc-ua-gateway/" }]} />
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s7); }
  .page-hero h1 { max-width: 22ch; }
  .page-hero .notice { max-width: 68ch; }
  .split { align-items: start; gap: var(--hl-s8); }
  pre { overflow-x: auto; }
  .steps { display: grid; gap: var(--hl-s3); padding-inline-start: 1.4em; max-width: 78ch; color: var(--hl-ink-soft); }
  .note { max-width: 72ch; margin-top: var(--hl-s5); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--hl-s6); justify-content: space-between; align-items: center; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .cta .stack { max-width: 62ch; }
</style>
