---
import Base from '../layouts/Base.astro';
import AlsoSee from '../components/AlsoSee.astro';
import CardDetail from '../components/CardDetail.astro';
import FamilyLine from '../components/FamilyLine.astro';
import JsonLd from '../components/JsonLd.astro';
import FeatureList from '../components/FeatureList.astro';
import { CURRENT, EDGE_FEATURES } from '../lib/products';
import { forPage } from '../i18n/page';

const { locale, t, rich, to } = forPage(Astro.url.pathname);
---

<Base
  title={t('edge.title')}
  description={t('edge.desc', { version: CURRENT })}
  ogAlt={t('edge.ogAlt')}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop Edge',
      url: 'https://hotloop.io/edge/',
      description:
        'HotLoop IoT plus the machine layer: store-and-forward over Sparkplug B that survives a dead uplink, and an OPC UA server, for a box that sits next to a machine.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Linux',
      license: 'https://hotloop.io/license/',
      isAccessibleForFree: true,
      softwareVersion: CURRENT,
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster"><span class="label">HotLoop Edge</span><span class="chip ok">{t('iot.out', { version: CURRENT })}</span></div>
      <h1>{t('edge.h1')}</h1>
      <p class="lede" set:html={rich('edge.lede')} />
      <div class="notice info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
        <div>
          <strong>{t('edge.nTitle', { version: CURRENT })}</strong>
          <p set:html={rich('edge.nBody')} />
        </div>
      </div>
      <div class="cluster">
        <a class="btn primary" href="#install">{t('iot.btnInstall')}</a>
        <a class="btn" href={to('/products/')}>{t('iot.btnCompare')}</a>
        <a class="btn" href="https://docs.hotloop.io/edge/overview/">{t('fl.docs')}</a>
      </div>
      <FamilyLine id="edge" />
    </div>
  </section>

  <section class="block">
    <div class="wrap grid grid-2 split">
      <div class="stack">
        <span class="label">{t('edge.l1')}</span>
        <h2>{t('edge.h2a')}</h2>
        <p class="muted">{t('edge.p1')}</p>
      </div>
      <div class="stack">
        <span class="label">{t('edge.l2')}</span>
        <h2>{t('edge.h2b')}</h2>
        <p class="muted" set:html={rich('edge.p2', { db: t('p.db.edge') })} />
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('edge.l3')}</span>
        <h2>{t('edge.h2c')}</h2>
        <p class="lede" set:html={rich('edge.lede3', { released: t('st.released'), planned: t('st.planned') })} />
      </div>
      <FeatureList features={EDGE_FEATURES} />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('edge.l4')}</span>
        <h2>{t('edge.h2d')}</h2>
        <p class="lede">{t('edge.lede4')}</p>
      </div>
      <div class="grid grid-2 split">
        <div class="stack">
          <h3>{t('edge.hBuilt')}</h3>
          <p class="muted">{t('edge.pBuilt')}</p>
        </div>
        <div class="stack">
          <h3>{t('edge.hPlan')}</h3>
          <p class="muted">{t('edge.pPlan')}</p>
        </div>
      </div>
      <CardDetail label={t('edge.cdLabel')}>
        <div><h4>{t('edge.d1h')}</h4><p>{t('edge.d1p')}</p></div>
        <div><h4>{t('edge.d2h')}</h4><p>{t('edge.d2p')}</p></div>
        <div><h4>{t('edge.d3h')}</h4><p>{t('edge.d3p')}</p></div>
        <div><h4>{t('edge.d4h')}</h4><p>{t('edge.d4p')}</p></div>
        <div><h4>{t('edge.d5h')}</h4><p>{t('edge.d5p')}</p></div>
      </CardDetail>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('iot.l4')}</span>
        <h2>{t('iot.h2d')}</h2>
        <p class="lede">{t('edge.lede5')}</p>
      </div>
      <div class="grid grid-2 split">
        <div class="stack">
          <h3>{t('iot.hK8s')}</h3>
<pre><code>helm repo add hotloop https://hotloop.io/hotloop
helm repo update
helm install hotloop hotloop/hotloop-edge --version {CURRENT} \
  --namespace hotloop --create-namespace</code></pre>
          <p class="muted">{t('edge.k8sP')}</p>
        </div>
        <div class="stack">
          <h3>{t('edge.hPlain')}</h3>
          <p class="muted" set:html={t('edge.plainP1')} />
          <p class="muted">{t('edge.plainP2')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('iot.l5')}</span>
        <h2>{t('edge.h2e')}</h2>
      </div>
      <div class="grid grid-3">
        <article class="card reveal"><h3>{t('iot.c1h')}</h3><p>{t('edge.c1p')}</p></article>
        <article class="card reveal"><h3>{t('iot.c3h')}</h3><p>{t('iot.c3p')}</p></article>
        <article class="card reveal"><h3>{t('edge.c2h')}</h3><p>{t('edge.c2p')}</p></article>
      </div>
      <div class="notice after">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
        <div>
          <strong>{t('edge.nwTitle')}</strong>
          <p set:html={rich('edge.nwBody')} />
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card cta reveal">
        <div class="stack">
          <span class="label">{t('iot.l6')}</span>
          <h2>{t('iot.h2f')}</h2>
          <p class="muted" set:html={rich('edge.licP')} />
        </div>
        <a class="btn primary" href="/license/">{t('iot.licBtn')}</a>
      </div>
    </div>
  </section>
  <AlsoSee heading="Looking for an edge gateway with an OPC UA server?" items={[{ label: "An OPC UA gateway and Kepware alternative", href: "/opc-ua-gateway/" }, { label: "Modbus to MQTT, step by step", href: "/modbus-to-mqtt/" }]} />
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s7); }
  .page-hero h1 { max-width: 20ch; }
  .page-hero .notice { max-width: 68ch; }
  .after { margin-top: var(--hl-s6); }
  .split { align-items: start; gap: var(--hl-s8); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--hl-s6); justify-content: space-between; align-items: center; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .cta .stack { max-width: 62ch; }
</style>
