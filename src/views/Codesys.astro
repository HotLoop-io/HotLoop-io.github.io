---
import Base from '../layouts/Base.astro';
import CardMore from '../components/CardMore.astro';
import FamilyLine from '../components/FamilyLine.astro';
import JsonLd from '../components/JsonLd.astro';
import CardDetail from '../components/CardDetail.astro';
import { CODESYS } from '../lib/products';
import { forPage } from '../i18n/page';

const { t, rich, to } = forPage(Astro.url.pathname);

const helmCmd = [
  'kubectl -n <namespace> create secret generic <release>-profile --from-file=profile.json',
  `helm repo add hotloop-codesys ${CODESYS.chartRepo}`,
  `helm install <release> hotloop-codesys/${CODESYS.chart} -n <namespace>`,
].join('\n');

// A card shows its heading and a short lead, and the rest of its text sits folded on the card. The lead,
// the rest and the long form are separate strings in every language, so no language is cut by a rule
// that only knows where an English sentence ends.
type Card = { h: string; p: string; m: string; l: string };
const card = (id: string, more: boolean, long: boolean): Card => ({
  h: t(`cy.${id}h`), p: t(`cy.${id}p`), m: more ? t(`cy.${id}m`) : '', l: long ? t(`cy.${id}l`) : '',
});
const does = [card('d1', false, true), card('d2', false, true), card('d3', false, false), card('d4', true, true)];
const wontDo = [card('w1', true, false), card('w2', true, false), card('w3', false, false), card('w4', false, false)];
const built = [card('b1', false, true), card('b2', false, false), card('b3', false, true), card('b4', false, true)];
const proven = [1, 2, 3].map((n) => [t(`cy.t${n}k`), t(`cy.t${n}`)]);
---

<Base
  title={t('cy.title')}
  description={t('cy.desc', { version: CODESYS.version })}
  ogAlt={t('cy.ogAlt')}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop for CODESYS',
      url: 'https://hotloop.io/codesys/',
      description:
        'HotLoop beside a CODESYS runtime: operator screens and alarms on the PLC\'s variables, read through the runtime\'s own OPC UA server with HotLoop\'s CODESYS connector, with nothing installed in CODESYS.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Linux',
      license: 'https://hotloop.io/license/',
      isAccessibleForFree: true,
      softwareVersion: CODESYS.version,
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />

  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster">
        <span class="label">HotLoop for CODESYS</span>
        <span class="chip ok">{t('cy.out', { version: CODESYS.version })}</span>
      </div>
      <h1>{t('cy.h1')}</h1>
      <p class="lede">{t('cy.lede')}</p>
      <div class="cluster">
        <a class="btn primary" href="#install">{t('cy.btnInstall')}</a>
        <a class="btn" href={to('/releases/codesys/')}>{t('fl.notes')}</a>
        <a class="btn" href="https://docs.hotloop.io/codesys/overview/">{t('fl.docs')}</a>
        <a class="btn" href={to('/products/')}>{t('cy.btnLineup')}</a>
      </div>
      <FamilyLine id="codesys" />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('iot.l3')}</span>
        <h2>{t('cy.h2a')}</h2>
        <p class="lede">{t('cy.lede1')}</p>
      </div>
      <div class="grid grid-2">
        {does.map((c) => (
          <article class="card reveal">
            <h3>{c.h}</h3>
            <p>{c.p}</p>
            {c.m && <CardMore label={t('c.more')}>{c.m}</CardMore>}
          </article>
        ))}
      </div>
      <CardDetail label={t('c.detail')}>
        {does.filter((c) => c.l).map((c) => <div><h4>{c.h}</h4><p>{c.l}</p></div>)}
      </CardDetail>
    </div>
  </section>

  <section class="block" id="screens">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('cy.l2')}</span>
        <h2>{t('cy.h2b')}</h2>
        <p class="lede">{t('cy.lede2')}</p>
      </div>
      <div class="shots">
        <figure>
          <img class="shot light" src="/codesys/screen.png" width="1440" height="900" loading="lazy" alt={t('cy.s1Alt')} />
          <img class="shot dark" src="/codesys/screen-dark.png" width="1440" height="900" loading="lazy" alt={t('cy.s1AltD')} />
          <figcaption>{t('cy.s1Cap')}</figcaption>
        </figure>
        <figure>
          <img class="shot light" src="/codesys/alarms.png" width="1440" height="900" loading="lazy" alt={t('cy.s2Alt')} />
          <img class="shot dark" src="/codesys/alarms-dark.png" width="1440" height="900" loading="lazy" alt={t('cy.s2AltD')} />
          <figcaption>{t('cy.s2Cap')}</figcaption>
        </figure>
        <figure>
          <img class="shot light" src="/codesys/device.png" width="1440" height="900" loading="lazy" alt={t('cy.s3Alt')} />
          <img class="shot dark" src="/codesys/device-dark.png" width="1440" height="900" loading="lazy" alt={t('cy.s3AltD')} />
          <figcaption>{t('cy.s3Cap')}</figcaption>
        </figure>
        <figure class="phone">
          <img class="shot light" src="/codesys/screen-phone.png" width="390" height="844" loading="lazy" alt={t('cy.s4Alt')} />
          <img class="shot dark" src="/codesys/screen-phone-dark.png" width="390" height="844" loading="lazy" alt={t('cy.s4AltD')} />
          <figcaption>{t('cy.s4Cap')}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('cy.l3')}</span>
        <h2>{t('cy.h2c')}</h2>
      </div>
      <div class="grid grid-2">
        {wontDo.map((c) => (
          <article class="card reveal">
            <h3>{c.h}</h3>
            <p>{c.p}</p>
            {c.m && <CardMore label={t('c.more')}>{c.m}</CardMore>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('cy.l4')}</span>
        <h2>{t('cy.h2d', { version: CODESYS.version })}</h2>
        <p class="lede">{t('cy.lede4')}</p>
      </div>
      <div class="grid grid-2">
        {built.map((c) => (
          <article class="card reveal">
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </article>
        ))}
      </div>
      <CardDetail label={t('c.detail')}>
        {built.filter((c) => c.l).map((c) => <div><h4>{c.h}</h4><p>{c.l}</p></div>)}
      </CardDetail>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('cy.l5')}</span>
        <h2>{t('cy.h2e')}</h2>
        <p class="lede">{t('cy.lede5')}</p>
      </div>
      <div class="grid grid-2">
        <article class="card reveal">
          <h3>Helm</h3>
          <p class="muted">{t('cy.helmP')}</p>
          <CardMore label={t('cy.cmds')}><pre><code>{helmCmd}</code></pre></CardMore>
        </article>
        <article class="card reveal">
          <h3>{t('cy.enH')}</h3>
          <p>{t('cy.enP')}</p>
          <CardMore label={t('c.more')}>{t('cy.enM')}</CardMore>
        </article>
      </div>
      <p class="muted note" set:html={rich('cy.note5')} />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('cy.l6')}</span>
        <h2>{t('cy.h2f')}</h2>
      </div>
      <div class="table-wrap">
        <table class="data stack">
          <thead><tr><th>{t('cy.thCheck')}</th><th>{t('cy.thWhat')}</th></tr></thead>
          <tbody>
            {proven.map(([k, v]) => <tr><td class="mono">{k}</td><td data-label={t('cy.thWhat')}>{v}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="muted note" set:html={rich('cy.note6')} />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card cta reveal">
        <div class="stack">
          <span class="label">{t('iot.l6')}</span>
          <h2>{t('cy.licH')}</h2>
          <p class="muted" set:html={rich('cy.licP')} />
        </div>
        <a class="btn primary" href={to('/license/')}>{t('iot.licBtn')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s7); }
  .page-hero h1 { max-width: 22ch; }
  .page-hero .notice { max-width: 68ch; }
  .note { max-width: 72ch; margin-top: var(--hl-s5); }
  pre { overflow-x: auto; }
  .shots { display: grid; gap: var(--hl-s6); }
  .shots figure { margin: 0; display: grid; gap: var(--hl-s2); }
  .shots figcaption { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); max-width: 72ch; }
  .shots figure.phone { max-width: 340px; }
  .shot { width: 100%; height: auto; border: 1px solid var(--hl-border); border-radius: var(--hl-r-card); }
  .shot.dark { display: none; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--hl-s6); justify-content: space-between; align-items: center; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .cta .stack { max-width: 62ch; }
</style>
<style is:global>
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .shot.light { display: none; }
    :root:not([data-theme="light"]) .shot.dark { display: block; }
  }
  :root[data-theme="dark"] .shot.light { display: none; }
  :root[data-theme="dark"] .shot.dark { display: block; }
  :root[data-theme="light"] .shot.light { display: block; }
  :root[data-theme="light"] .shot.dark { display: none; }
</style>
