---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { forPage } from '../i18n/page';

const { filter } = Astro.props;
const { locale, t, to } = forPage(Astro.url.pathname);
const all = (await getCollection('releases')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.version.localeCompare(a.data.version, undefined, { numeric: true }));
const shown = filter === 'all' ? all : all.filter((r) => r.data.product === filter);
// The notes are markdown, so they are rendered, not printed with their pound signs.
// In another language an entry reads from its translation (src/content/releases-i18n); one that has none yet is
// the English entry with a note, so no entry ever goes missing from a page.
const translated = locale.code === 'en' ? [] : (await getCollection('releasesI18n')).filter((e) => e.data.lang === locale.path);
const tr = new Map(translated.map((e) => [`${e.data.product}/${e.data.version}`, e]));
const releases = await Promise.all(
  shown.map(async (r) => {
    const x = tr.get(`${r.data.product}/${r.data.version}`);
    const src = x ?? r;
    return {
      ...r,
      english: locale.code !== 'en' && !x,
      summary: x ? x.data.summary : r.data.summary,
      highlights: x ? x.data.highlights : r.data.highlights,
      breaking: x ? x.data.breaking : r.data.breaking,
      Body: src.body && src.body.trim() ? (await render(src)).Content : null,
    };
  }),
);

const NAME = { core: 'HotLoop core', flow: 'Flow', cascade: 'Cascade', codesys: 'HotLoop for CODESYS', transmitter: 'HotLoop Transmitter' } as const;
// Western digits in every language, as the Arabic style sheet asks.
const fmt = (d: Date) => d.toLocaleDateString(locale.code === 'en' ? 'en-US' : `${locale.tag}-u-nu-latn`, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const unpublished = all.filter((r) => r.data.product === 'core' && !r.data.published);
const coreLatest = all.find((r) => r.data.product === 'core' && r.data.published);

// An unpublished version older than a published one was never a release of its
// own, but its work is in that release, and the chip says which one.
const older = (a: string, b: string) => a.localeCompare(b, undefined, { numeric: true }) < 0;
const chipFor = (r: (typeof all)[number]) => {
  if (r.data.published) return { cls: 'ok', label: t('rel.published') };
  // `all` is newest first, so the last match is the first release it went out in.
  const first = all.filter((p) => p.data.product === r.data.product && p.data.published && older(r.data.version, p.data.version)).at(-1);
  return first ? { cls: 'info', label: t('rel.shippedIn', { version: first.data.version }) } : { cls: 'warn', label: t('rel.merged') };
};
// The release that finally shipped the untagged run. Not simply the newest
// release: once 4.17.0 came out, "until 4.17.0" would have been a lie about
// what 4.16.0 did.
const shippedIn = unpublished[0] && all.filter((p) => p.data.product === 'core' && p.data.published && older(unpublished[0].data.version, p.data.version)).at(-1);
const title = filter === 'all' ? t('rel.h1') : t('rel.h1p', { name: NAME[filter as keyof typeof NAME] });

// Three pages, three different titles and descriptions. Identical ones make search
// engines pick one of them arbitrarily and ignore the rest.
const coreFirst = all.filter((r) => r.data.product === 'core').at(-1)?.data.version;
const seo = {
  all: { title: t('rel.tAll'), description: t('rel.dAll') },
  core: { title: t('rel.tCore'), description: t('rel.dCore', { first: coreFirst }) },
  flow: { title: t('rel.tFlow'), description: t('rel.dFlow', { first: '0.1.0' }) },
  cascade: { title: t('rel.tCascade'), description: t('rel.dCascade', { first: '0.1.1', last: '1.4.1' }) },
  codesys: { title: t('rel.tCodesys'), description: t('rel.dCodesys', { first: '0.3.0', last: '0.3.8' }) },
  transmitter: { title: t('rel.tTransmitter'), description: t('rel.dTransmitter', { first: '1.0.0' }) },
}[filter as 'all' | 'core' | 'flow' | 'cascade' | 'codesys' | 'transmitter'];
---

<Base
  title={seo.title}
  description={seo.description}
  ogAlt={t('rel.ogAlt')}
>
  <section class="page-hero">
    <div class="wrap stack">
      <span class="label">{t('rel.label')}</span>
      <h1>{title}</h1>
      <nav class="cluster tabs" aria-label={t('rel.tabsAria')}>
        <a class="pill" href={to('/releases/')} aria-current={filter === 'all' ? 'page' : undefined}>{t('rel.tabAll')}</a>
        <a class="pill" href={to('/releases/core/')} aria-current={filter === 'core' ? 'page' : undefined}>HotLoop core</a>
        <a class="pill" href={to('/releases/flow/')} aria-current={filter === 'flow' ? 'page' : undefined}>Flow</a>
        <a class="pill" href={to('/releases/cascade/')} aria-current={filter === 'cascade' ? 'page' : undefined}>Cascade</a>
        <a class="pill" href={to('/releases/codesys/')} aria-current={filter === 'codesys' ? 'page' : undefined}>HotLoop for CODESYS</a>
        <a class="pill" href={to('/releases/transmitter/')} aria-current={filter === 'transmitter' ? 'page' : undefined}>Transmitter</a>
        <a class="pill rss" href={to('/releases/rss.xml')}>RSS</a>
      </nav>

      {(filter === 'all' || filter === 'core') && unpublished.length > 0 && coreLatest && shippedIn && (
        <div class="notice info">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
          <div>
            <strong>{t('rel.nTitle', { latest: coreLatest.data.version, from: unpublished[unpublished.length - 1].data.version, to: unpublished[0].data.version })}</strong>
            <p>{t('rel.nBody', { ship: shippedIn.data.version })}</p>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="wrap feed">
    {releases.some((r) => r.english) && <p class="muted">{t('rel.english')}</p>}
    {releases.map((r) => {
      return (
        <article class="entry" id={`${r.data.product}-${r.data.version}`}>
          <header>
            <div class="cluster">
              <h2><a href={`#${r.data.product}-${r.data.version}`}>{NAME[r.data.product]} {r.data.version}</a></h2>
              <span class={`chip ${chipFor(r).cls}`}>{chipFor(r).label}</span>
            </div>
            <time class="mono" datetime={r.data.date.toISOString().slice(0, 10)}>{fmt(r.data.date)}</time>
          </header>
          <p class="summary" lang={r.english ? 'en' : undefined}>{r.summary}</p>
          <ul lang={r.english ? 'en' : undefined}>{r.highlights.map((h) => <li>{h}</li>)}</ul>
          {r.breaking.length > 0 && (
            <div class="notice">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
              <div><strong>{t('rel.breaking')}</strong><ul lang={r.english ? 'en' : undefined}>{r.breaking.map((b) => <li>{b}</li>)}</ul></div>
            </div>
          )}
          {r.Body && <div class="note" lang={r.english ? 'en' : undefined}><r.Body /></div>}
        </article>
      );
    })}
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 6vw, var(--hl-s8)) var(--hl-s6); }
  .page-hero .notice { max-width: 72ch; }
  .pill { padding: 0.45em 1.1em; border-radius: var(--hl-r-pill); border: 1px solid var(--hl-border); background: var(--hl-card); color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); font-weight: 600; text-decoration: none; }
  .pill:hover { color: var(--hl-ink); border-color: var(--hl-line-strong); }
  .pill[aria-current='page'] { background: var(--hl-ink); border-color: var(--hl-ink); color: var(--hl-bg); }

  .feed { max-width: 820px; padding-block: var(--hl-s6) var(--hl-s8); display: grid; gap: 0; }
  /* Image names and URLs in the notes are one unbreakable word each, and at
     320px one of them was enough to push the whole page sideways. */
  .entry { padding-block: var(--hl-s7); border-top: 1px solid var(--hl-border); display: grid; gap: var(--hl-s3); overflow-wrap: anywhere; }
  .entry > * { min-width: 0; }
  .entry:first-child { border-top: 0; }
  .entry header { display: grid; gap: var(--hl-s1); }
  .entry h2 { font-size: var(--hl-fs-xl); }
  .entry h2 a { color: var(--hl-ink); text-decoration: none; }
  .entry h2 a:hover { color: var(--hl-link); }
  time { font-size: var(--hl-fs-xs); color: var(--hl-ink-soft); }
  .summary { font-size: var(--hl-fs-md); font-weight: 600; }
  .entry > ul { padding-left: 1.2em; display: grid; gap: var(--hl-s2); color: var(--hl-ink-soft); }
  .entry .notice ul { padding-left: 1.2em; display: grid; gap: var(--hl-s1); color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); }
  .note { color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); padding-left: var(--hl-s4); border-left: 2px solid var(--hl-border); }
</style>
