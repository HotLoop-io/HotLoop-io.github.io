---
import Base from '../layouts/Base.astro';
import CardDetail from '../components/CardDetail.astro';
import FamilyLine from '../components/FamilyLine.astro';
import JsonLd from '../components/JsonLd.astro';
import FeatureList from '../components/FeatureList.astro';
import { CURRENT, IOT_FEATURES } from '../lib/products';
import { forPage } from '../i18n/page';
import { DEFAULT } from '../i18n/locales';

const { locale, t, rich, to } = forPage(Astro.url.pathname);
---

<Base
  title={t('iot.title')}
  description={t('iot.desc', { version: CURRENT })}
  ogAlt={t('iot.ogAlt')}
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HotLoop IoT',
      url: 'https://hotloop.io/iot/',
      description:
        'An automation base for operational technology, written natively in Go: entities, automations, helpers, scripts, the logbook, dashboards, alarms, notifications, AI agents, and MQTT with discovery, plus industrial protocol drivers.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Linux',
      license: 'https://hotloop.io/license/',
      isAccessibleForFree: true,
      softwareVersion: CURRENT,
      publisher: { '@id': 'https://hotloop.io/#organization' },
    }}
  />
  <section class="page-hero">
    <div class="wrap stack">
      <div class="cluster"><span class="label">HotLoop IoT</span><span class="chip ok">{t('iot.out', { version: CURRENT })}</span></div>
      <h1>{t('iot.h1')}</h1>
      <p class="lede">{t('iot.lede')}</p>
      <div class="notice info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
        <div>
          <strong>{t('iot.nTitle', { version: CURRENT })}</strong>
          <p>{t('iot.nBody')}</p>
        </div>
      </div>
      <div class="cluster">
        <a class="btn primary" href="#install">{t('iot.btnInstall')}</a>
        <a class="btn" href={to('/products/')}>{t('iot.btnCompare')}</a>
        <a class="btn" href="https://docs.hotloop.io/iot/overview/">{t('fl.docs')}</a>
      </div>
      <FamilyLine id="iot" />
    </div>
  </section>

  <section class="block">
    <div class="wrap grid grid-2 split">
      <div class="stack">
        <span class="label">{t('iot.l1')}</span>
        <h2>{t('iot.h1b')}</h2>
        <p class="muted">{t('iot.p1a')}</p>
        <p class="muted">{t('iot.p1b')}</p>
      </div>
      <div class="stack">
        <span class="label">{t('iot.l2')}</span>
        <h2>{t('iot.h2b')}</h2>
        <p class="muted" set:html={rich('iot.p2a')} />
        <p class="muted" set:html={rich('iot.p2b', { db: t('p.db.iot') })} />
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('iot.l3')}</span>
        <h2>{t('iot.h2c')}</h2>
      </div>
      <div class="grid grid-2 split">
        <div class="stack">
          <p class="muted" set:html={t('iot.pr1')} />
          <p class="muted" set:html={t('iot.pr2')} />
        </div>
        <div class="stack">
          <p class="muted" set:html={t('iot.pr3')} />
          <p class="muted" set:html={t('iot.pr4')} />
        </div>
      </div>
      <CardDetail label={t('iot.cdLabel')}>
        <p class="muted">{t('iot.statusNote', { released: t('st.released'), building: t('st.building'), planned: t('st.planned') })}</p>
        {locale !== DEFAULT && <p class="muted">{t('fl.english')}</p>}
        <FeatureList features={IOT_FEATURES} />
      </CardDetail>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('iot.l4')}</span>
        <h2>{t('iot.h2d')}</h2>
        <p class="lede">{t('iot.lede2')}</p>
      </div>
      <div class="grid grid-2 split">
        <div class="stack">
          <h3>{t('iot.hK8s')}</h3>
<pre><code>helm repo add hotloop https://hotloop.io/hotloop
helm repo update
helm install hotloop hotloop/hotloop-iot --version {CURRENT} \
  --namespace hotloop --create-namespace</code></pre>
          <p class="muted">{t('iot.k8sP')}</p>
        </div>
        <div class="stack">
          <h3>{t('iot.hPi')}</h3>
          <p class="muted" set:html={t('iot.piP1')} />
          <p class="muted">{t('iot.piP2')}</p>
        </div>
      </div>
      <p class="prose muted after">{t('iot.after')}</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="label">{t('iot.l5')}</span>
        <h2>{t('iot.h2e')}</h2>
      </div>
      <div class="grid grid-3">
        <article class="card reveal"><h3>{t('iot.c1h')}</h3><p>{t('iot.c1p')}</p></article>
        <article class="card reveal"><h3>{t('iot.c2h')}</h3><p>{t('iot.c2p')}</p></article>
        <article class="card reveal"><h3>{t('iot.c3h')}</h3><p>{t('iot.c3p')}</p></article>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="card cta reveal">
        <div class="stack">
          <span class="label">{t('iot.l6')}</span>
          <h2>{t('iot.h2f')}</h2>
          <p class="muted" set:html={rich('iot.licP')} />
        </div>
        <a class="btn primary" href="/license/">{t('iot.licBtn')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 7vw, var(--hl-s9)) var(--hl-s7); }
  .page-hero h1 { max-width: 20ch; }
  .page-hero .notice { max-width: 68ch; }
  .split { align-items: start; gap: var(--hl-s8); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--hl-s6); justify-content: space-between; align-items: center; padding: clamp(var(--hl-s6), 5vw, var(--hl-s8)); }
  .cta .stack { max-width: 62ch; }
</style>
