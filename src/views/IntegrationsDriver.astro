---
import Base from '../layouts/Base.astro';
import WordOrder from '../components/WordOrder.astro';
import JsonLd from '../components/JsonLd.astro';
import { TIERS } from '../lib/tiers';
import { forPage } from '../i18n/page';
import { DEFAULT } from '../i18n/locales';

const { entry, prev, next } = Astro.props;
const { locale, t, to } = forPage(Astro.url.pathname);
const other = locale !== DEFAULT;
const ps = (field: string, fallback: string) => (other ? t(`pr.${entry.id}.${field}`) : fallback);
const p = entry.data;
const tier = TIERS[p.verification];
const seo = other ? undefined : p.seo;

// Search engines truncate a description near 160 characters. Prefer the summary
// with its verification tier, and fall back to the summary alone when that is too long.
const summary = ps('sum', p.summary);
const withTier = `${summary} ${other ? t('int.pVer', { label: t(`t.${p.verification}.label`) }) : `Verification: ${tier.label}.`}`;
const description = seo ? seo.description : withTier.length <= 160 ? withTier : summary;

// "Everything else" is not a useful page title, so the gateway-mode page says what it covers.
const title = seo
  ? seo.title
  : entry.id === 'gateway-mode'
    ? t('int.pTitleGm')
    : t('int.pTitle', { name: p.name });

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'HotLoop', item: 'https://hotloop.io/' },
    { '@type': 'ListItem', position: 2, name: 'Integrations', item: 'https://hotloop.io/integrations/' },
    { '@type': 'ListItem', position: 3, name: p.name, item: `https://hotloop.io/integrations/${entry.id}/` },
  ],
};
---

<Base title={title} description={description} ogAlt={t('int.pOgAlt', { name: p.name })}>
  <JsonLd slot="head" data={seo ? [breadcrumbs, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: seo.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : breadcrumbs} />
  <section class="page-hero">
    <div class="wrap stack">
      <p class="crumb"><a href={to('/integrations/')}>{t('int.crumb')}</a> <span aria-hidden="true">/</span> {p.name}</p>
      <div class="cluster">
        <h1>{seo ? seo.h1 : p.name}</h1>
        <span class={`chip ${tier.chip}`}>{t(`t.${p.verification}.label`)}</span>
      </div>
      <p class="lede">{summary}</p>
      {seo && seo.intro.map((x) => <p class="lede" set:html={x} />)}
      {!other && <p class="lede"><strong>Twelve native drivers, each listed with what it was tested against. Free to use, no license keys.</strong></p>}

      {(p.verification === 'decode' || p.notVerifiedNote.trim() !== '') && (
        <div class="notice">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
          <div>
            <strong>{(p.notVerifiedHeading ? ps('nvh', p.notVerifiedHeading) : '') || t('int.commissioning')}</strong>
            <p>{p.notVerifiedNote ? ps('nvn', p.notVerifiedNote) : ''}</p>
          </div>
        </div>
      )}

      {p.verifiedAgainst.length > 0 && (
        <p class="against">
          <strong>{t('int.vAgainst')}</strong>
          {p.verifiedAgainst.map((v, i) => <span class="chip none">{ps(`va${i + 1}`, v)}</span>)}
        </p>
      )}

      {p.vendors.length > 0 && (
        <p class="against">
          <strong>{t('int.worksWith')}</strong>
          {p.vendors.map((v) => <span class="chip none">{v}</span>)}
        </p>
      )}

      {p.aka.length > 0 && p.verification === 'gateway-mode' && (
        <p class="against">
          {p.aka.map((v) => <span class="chip info">{v}</span>)}
        </p>
      )}
    </div>
  </section>

  <section class="wrap body stack">
    {p.body.map((para, i) => <p>{ps(`b${i + 1}`, para)}</p>)}

    {p.trap && (
      <div class="notice info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" /></svg>
        <div><strong>{t('int.watch')}</strong><p>{ps('trap', p.trap)}</p></div>
      </div>
    )}

    {entry.id === 'modbus' && (<><h2>{t('int.wordOrder')}</h2><WordOrder /></>)}

    {seo && (
      <>
        <h2>Questions people ask</h2>
        {seo.faq.map((f) => (<details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>))}
        <h2>Keep reading</h2>
        <ul class="more">{seo.links.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
        <div class="cluster">
          <a class="btn primary" href="/contact/">Request a quote</a>
          <a class="btn" href="/talk-to-an-engineer/">Talk to an engineer</a>
        </div>
      </>
    )}

    <nav class="pager" aria-label={t('int.pagerAria')}>
      {prev ? <a href={to(`/integrations/${prev.id}/`)}>&larr; {prev.data.name}</a> : <span></span>}
      {next ? <a href={to(`/integrations/${next.id}/`)}>{next.data.name} &rarr;</a> : <span></span>}
    </nav>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(var(--hl-s7), 6vw, var(--hl-s8)) var(--hl-s6); }
  .page-hero h1 { font-size: var(--hl-fs-2xl); }
  .page-hero .notice { max-width: 72ch; }
  .crumb { font-size: var(--hl-fs-sm); color: var(--hl-ink-soft); }
  .against { display: flex; flex-wrap: wrap; gap: var(--hl-s2); align-items: center; font-size: var(--hl-fs-sm); }
  .against strong { margin-right: var(--hl-s2); }
  .against .chip { text-transform: none; letter-spacing: 0; font-size: var(--hl-fs-xs); white-space: normal; }
  .against .chip::before { display: none; }

  .body { max-width: 78ch; padding-bottom: var(--hl-s7); }
  .body > p { color: var(--hl-ink-soft); }
  .body h2 { font-size: var(--hl-fs-xl); margin-top: var(--hl-s7); }
  .faq { border-bottom: 1px solid var(--hl-border); padding-block: var(--hl-s3); }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin-top: var(--hl-s2); }
  .more { display: grid; gap: var(--hl-s2); padding-left: var(--hl-s4); }
  .keys { display: flex; flex-wrap: wrap; gap: var(--hl-s2); }
  .pager { display: flex; justify-content: space-between; margin-top: var(--hl-s8); padding-top: var(--hl-s5); border-top: 1px solid var(--hl-border); font-weight: 600; }
</style>
